<Project>
  <!--
    One version for every project (Core, CLI, App, tests). CI overrides it per release: dotnet publish -p:Version=1.2.3
    (tag v1.2.3). The SDK appends "+<commit sha>" to InformationalVersion when it knows the source revision;
    AppVersion.Current strips that.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.3.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
