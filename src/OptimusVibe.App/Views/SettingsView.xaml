<UserControl x:Class="OptimusVibe.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptimusVibe.App.Views"
             xmlns:vm="clr-namespace:OptimusVibe.App.ViewModels"
             xmlns:svc="clr-namespace:OptimusVibe.App.Services"
             xmlns:input="clr-namespace:OptimusVibe.App.Input"
             x:Name="Root">
    <!-- DataContext: SettingsViewModel. One column of cards; every control reachable with the D-pad, B goes back.
         Compact: every card is a collapsible section (one open at a time) and a pinned header carries the section index (LB / RB jump). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- compact header: back, title and the section index in one pinned row -->
        <Grid Style="{StaticResource Only.Compact}" Margin="14,2,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CompactBackButton" Style="{StaticResource Button.Icon}" Command="{Binding CloseCommand}" AutomationProperties.Name="Back" ToolTip="Back (B)">
                    <TextBlock Text="&#xE72B;" />
                </Button>
                <views:ButtonGlyph Kind="B" Size="Small" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" Margin="12,0,18,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <views:ButtonGlyph Kind="LB" Margin="0,0,8,0" />
                <ScrollViewer x:Name="IndexScroller" Style="{StaticResource HorizontalOnlyScroller}" Focusable="False">
                    <Border Style="{StaticResource SegmentStrip}">
                        <StackPanel x:Name="SectionIndex" Orientation="Horizontal" />
                    </Border>
                </ScrollViewer>
                <views:ButtonGlyph Kind="RB" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="{DynamicResource SettingsMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ContentColumn" Width="*" MaxWidth="1040" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SectionsPanel">

                <!-- title -->
                <StackPanel Margin="0,0,0,22" Style="{StaticResource Only.Comfortable}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-8,0,0,6">
                        <Button x:Name="BackButton" Style="{StaticResource Button.Icon}" Command="{Binding CloseCommand}" AutomationProperties.Name="Back"
                                ToolTip="Back">
                            <TextBlock Text="&#xE72B;" />
                        </Button>
                        <views:ButtonGlyph Kind="B" Size="Small" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Lead}" Margin="0,6,0,0"
                                   Text="Sync, launchers and how Optimus-Vibe looks after this device." />
                    </StackPanel>
                </StackPanel>

                <!-- ======================================================== a newer version (the one feature card) -->
                <Border Style="{StaticResource Card.Feature}" Margin="{DynamicResource CardMargin}" DataContext="{Binding Updates}"
                        Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="A new version is ready" Style="{StaticResource Text.H2}" Foreground="{DynamicResource FeatureTextBrush}" />
                        <TextBlock Text="{Binding AvailableText}" FontSize="14.5" Foreground="{DynamicResource OnFeatureDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBox Text="{Binding NotesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" MaxHeight="200" VerticalContentAlignment="Top" Margin="0,16,0,0"
                                 Background="{DynamicResource FeatureScrimBrush}" FontSize="14" AutomationProperties.Name="Release notes" />
                        <Button Style="{StaticResource Button.Large}" Command="{Binding InstallCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                Background="{DynamicResource FeatureButtonBrush}" Foreground="{DynamicResource FeatureButtonTextBrush}" AutomationProperties.Name="Download and restart" Content="Download and restart" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}">
                            <ProgressBar Style="{StaticResource BusyBar}" IsIndeterminate="False" Minimum="0" Maximum="1" Height="8" Foreground="{DynamicResource FeatureTextBrush}"
                                         Value="{Binding Progress, Mode=OneWay}" />
                            <TextBlock Text="{Binding ProgressText}" FontSize="14" Foreground="{DynamicResource OnFeatureDimBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================================================== sync -->
                <views:SettingsSection Header="Sync" ShortName="Sync">
                    <StackPanel>
                        <TextBlock Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Dim}">
                                    <Setter Property="Text" Value="Your saves and library sync with a local git folder." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGitHub}" Value="True">
                                            <Setter Property="Text" Value="Your saves and library sync through your GitHub account." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ProviderText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ProviderText}" />

                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsGitHub}" Margin="0,0,8,0"
                                    Command="{Binding FocusRepoCommand, ElementName=Root}" AutomationProperties.Name="GitHub account">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="GitHub account" />
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0" Text="The app keeps its own copy of your config repo. No git needed, best for the handheld." />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsGitHub, Converter={StaticResource Not}}" Margin="8,0,0,0"
                                    Command="{Binding UseLocalGitCommand}" AutomationProperties.Name="Use local git checkout instead">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Local git folder" />
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0" Text="Use a repo you cloned yourself and sync it with git." />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <WrapPanel Margin="0,16,0,0">
                            <CheckBox Content="Sync automatically" IsChecked="{Binding AutoSync}" Margin="0,0,24,0"
                                      ToolTip="Manual saves, opt-outs and queued games" />
                            <Button Command="{Binding SyncNowCommand}" AutomationProperties.Name="Sync now" Content="Sync now" />
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding AutoPull}" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Auto-update presets" FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="Fetch new presets when the app starts, every 15 minutes, and just before a game starts."
                                     Foreground="{DynamicResource TextDimBrush}" FontSize="14" />
                            </TextBlock>
                        </CheckBox>
                        <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource Text.Caption}" Margin="4,6,0,0" />
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== github account -->
                <views:SettingsSection x:Name="AccountCard" Header="GitHub account" ShortName="Account">
                    <StackPanel Margin="0,14,0,0">
                        <views:GitHubSignInPanel DataContext="{Binding Account}" />
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== repository -->
                <views:SettingsSection x:Name="RepoCard" Header="Config repo" ShortName="Repo" DataContext="{Binding Account}">
                    <StackPanel>
                        <Grid HorizontalAlignment="Right">
                            <Button Grid.Column="1" Style="{StaticResource Button.Quiet}" Command="{Binding LoadReposCommand}" AutomationProperties.Name="Reload repositories"
                                    Content="Reload list" Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0">
                            <Run Text="Your game settings live in" />
                            <Run Text="{Binding CurrentRepoText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0" Text="Sign in to GitHub above to pick a repository."
                                   Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />

                        <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}">
                            <TextBox x:Name="RepoSearch" Text="{Binding RepoFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,0"
                                     AutomationProperties.Name="Search repositories" ToolTip="Search your repositories" />
                            <TextBlock Text="Loading your repositories…" Style="{StaticResource Text.Dim}" Margin="4,10,0,0"
                                       Visibility="{Binding IsLoadingRepos, Converter={StaticResource VisibleWhen}}" />
                            <ListBox x:Name="RepoList" ItemsSource="{Binding FilteredRepos}" SelectedItem="{Binding SelectedRepo}"
                                     Style="{StaticResource GameList}" ItemContainerStyle="{StaticResource GameListItem}"
                                     MaxHeight="300" Margin="-4,10,-4,0"
                                     AutomationProperties.Name="Repositories">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RepoItemViewModel}">
                                        <StackPanel>
                                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                                <Run Text="{Binding FullName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                <Run Text="{Binding Description, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Private" Style="{StaticResource Text.Caption}" Margin="0,0,10,0"
                                                           Visibility="{Binding IsPrivate, Converter={StaticResource VisibleWhen}}" />
                                                <TextBlock Text="In use" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource AccentTextBrush}"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Repository" Style="{StaticResource Text.Dim}" Margin="4,0,0,6" />
                                    <TextBox Text="{Binding RepoName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                             AutomationProperties.Name="Repository (owner/name)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Branch" Style="{StaticResource Text.Dim}" Margin="4,0,0,6" />
                                    <TextBox Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                             AutomationProperties.Name="Branch" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding UseRepoCommand}" Margin="10,0,0,0"
                                        VerticalAlignment="Bottom" AutomationProperties.Name="Use this repo" Content="Use this repo" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="4,10,0,0"
                                       Text="The app downloads the repo into its own copy and syncs through your account. Switching branches replaces that copy, so sync first if you have unsynced saves." />

                            <!-- picked repo isn't a config repo yet: confirm before seeding it -->
                            <Border Style="{StaticResource Card.Inset}" Margin="0,16,0,0"
                                    Visibility="{Binding HasSeedPrompt, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SeedPrompt}" Style="{StaticResource Text.Body}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmSeedCommand}" Margin="0,0,8,0"
                                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Seed this repo" Content="Seed and use this repo" />
                                        <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CancelSeedCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- create a new config repo -->
                            <Button Command="{Binding OpenCreateCommand}" Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Visibility="{Binding IsCreateOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                                    AutomationProperties.Name="Create a new config repo" Content="Create a new config repo…" />
                            <Border Style="{StaticResource Card.Inset}" Margin="0,16,0,0"
                                    Visibility="{Binding IsCreateOpen, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Text="New repository name" Style="{StaticResource Text.Dim}" Margin="4,0,0,6" />
                                    <TextBox Text="{Binding NewRepoName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                             input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="New repository name" Background="{DynamicResource InsetDeepBrush}" />
                                    <CheckBox IsChecked="{Binding NewRepoPrivate}" Content="Private repository (recommended)" Margin="0,12,0,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="4,8,0,0"
                                               Text="Creates the repo under your account, fills it with a starter config and switches sync to it." />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource Button.Primary}" Command="{Binding CreateRepoCommand}" Margin="0,0,8,0"
                                                AutomationProperties.Name="Create and use repo" Content="Create and use" />
                                        <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CancelCreateCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== game lab -->
                <views:SettingsSection x:Name="LabCard" Header="Game lab" ShortName="Lab" DataContext="{Binding Lab}">
                    <StackPanel>
                        <Grid HorizontalAlignment="Right">
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Checking…" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Visibility="{Binding IsChecking, Converter={StaticResource VisibleWhen}}" />
                                <Button Style="{StaticResource Button.Quiet}" Command="{Binding CheckAgainCommand}" Content="Check again" AutomationProperties.Name="Check the game lab again" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Intro}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Cost}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding CheckError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasCheckError, Converter={StaticResource VisibleWhen}}" />

                        <!-- the wizard: one line per step, the current one open -->
                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LabStepViewModel}">
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8" Padding="18,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- mark: number, or a tick when done -->
                                            <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Margin="0,2,16,0"
                                                    BorderThickness="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                               Visibility="{Binding IsDone, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource OnAccentBrush}" Visibility="{Binding IsDone, Converter={StaticResource VisibleWhen}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Text="Next" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="12,2,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}" />
                                                        <TextBlock Text="Skipped" FontSize="12.5" Foreground="{DynamicResource TextFaintBrush}" Margin="12,2,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSkipped, Converter={StaticResource VisibleWhen}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource Button.Quiet}" Command="{Binding ToggleCommand}" Content="Run again"
                                                            Visibility="{Binding ShowRerun, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Run this step again" />
                                                </Grid>
                                                <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource VisibleWhen}}" />
                                                <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource AttentionBrush}" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource VisibleWhen}}" />

                                                <!-- the open step: its action -->
                                                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowBody, Converter={StaticResource VisibleWhen}}">

                                                    <!-- the one GitHub sign-in lives in the GitHub account card; this step only sends you there -->
                                                    <StackPanel Visibility="{Binding IsScopes, Converter={StaticResource VisibleWhen}}">
                                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                                   Text="This uses your one GitHub sign-in, the same one as the config repo and bug reports. Sign in again opens it in the GitHub account card above and asks for repo, workflow and project. Using a personal access token instead? Make a classic token with those three scopes, or a fine-grained one on your config repo with Contents, Issues, Actions, Secrets, Variables, Workflows and Administration (read and write)." />
                                                        <Button Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding DataContext.OpenTokenCommand, ElementName=LabCard}"
                                                                Content="Create a token on github.com" />
                                                    </StackPanel>

                                                    <!-- Claude token -->
                                                    <StackPanel Visibility="{Binding IsSecret, Converter={StaticResource VisibleWhen}}">
                                                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                                                            <Run Text="Run" />
                                                            <Run Text="claude setup-token" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                                            <Run Text="in a terminal and paste the token it prints (starts with sk-ant-oat01-)." />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Text="This is your Claude subscription token, not an API key: the lab runs on your Claude plan with no per-use billing, like the Optimus-Vibe repo. It goes straight to GitHub, encrypted, as a secret of your config repo, and is not kept on this PC." />
                                                        <Grid Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <PasswordBox x:Name="ClaudeTokenBox" MinWidth="360" AutomationProperties.Name="Claude token" />
                                                            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="{Binding ActionText}" Command="{Binding RunCommand}"
                                                                    CommandParameter="{Binding ElementName=ClaudeTokenBox}" Margin="10,0,0,0" MinWidth="120" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- daily cap + model -->
                                                    <StackPanel Visibility="{Binding IsVariables, Converter={StaticResource VisibleWhen}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Research runs per day" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                            <Button Style="{StaticResource Button.Icon}" Command="{Binding DataContext.DailyMaxDownCommand, ElementName=LabCard}" AutomationProperties.Name="Fewer runs per day">
                                                                <TextBlock Text="&#xE738;" />
                                                            </Button>
                                                            <TextBox Text="{Binding DataContext.DailyMax, ElementName=LabCard, UpdateSourceTrigger=LostFocus}" Width="64" TextAlignment="Center"
                                                                     AutomationProperties.Name="Research runs per day" />
                                                            <Button Style="{StaticResource Button.Icon}" Command="{Binding DataContext.DailyMaxUpCommand, ElementName=LabCard}" AutomationProperties.Name="More runs per day">
                                                                <TextBlock Text="&#xE710;" />
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="Model" Style="{StaticResource Text.Body}" Margin="0,12,0,6" />
                                                        <ItemsControl ItemsSource="{Binding DataContext.Models, ElementName=LabCard}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                                                                    <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsOn}" Margin="0,0,8,8" MinWidth="170" Padding="16,10"
                                                                            AutomationProperties.Name="{Binding Label}"
                                                                            Command="{Binding DataContext.SetModelCommand, ElementName=LabCard}" CommandParameter="{Binding}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Button HorizontalAlignment="Left" Command="{Binding RunCommand}" Content="{Binding ActionText}" MinWidth="150"
                                                            Style="{StaticResource Button.Primary}" AutomationProperties.Name="{Binding ActionText}"
                                                            Visibility="{Binding IsGeneric, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- status once it is set up -->
                        <Border Style="{StaticResource Card.Feature}" Margin="0,8,0,0" Visibility="{Binding ShowStatus, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.H3}" Foreground="{DynamicResource FeatureTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CountsText}" FontSize="14.5" Foreground="{DynamicResource OnFeatureDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Command="{Binding RunNowCommand}" Content="Run now" Margin="0,0,8,0" Background="{DynamicResource FeatureButtonBrush}"
                                            Foreground="{DynamicResource FeatureButtonTextBrush}" ToolTip="Start the oldest waiting request now, or retry the oldest failed one" AutomationProperties.Name="Run now" />
                                    <Button Command="{Binding OpenBoardCommand}" Content="Open board" Margin="0,0,8,0" AutomationProperties.Name="Open the board" />
                                    <Button Command="{Binding OpenRepoCommand}" Content="Open repo" AutomationProperties.Name="Open the config repo" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <CheckBox IsChecked="{Binding AutoRequest}" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Request presets for new games automatically" FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="Newly found games without presets go to the game lab. Off (or lab not set up): they are queued in requests.yaml for Claude Code, as before. This machine only."
                                     Foreground="{DynamicResource TextDimBrush}" FontSize="14" />
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== app updates (the APP repo, not the config repo above) -->
                <views:SettingsSection x:Name="UpdatesCard" Header="Updates" ShortName="Updates" DataContext="{Binding Updates}">
                    <StackPanel>
                        <TextBlock Text="{Binding VersionText, Mode=OneWay}" Style="{StaticResource Text.Dim}" Margin="0,4,0,0" />

                        <Button Command="{Binding CheckCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                AutomationProperties.Name="Check for updates" Content="Check for updates" />

                        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="15"
                                   Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhen}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Dim}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== library -->
                <views:SettingsSection Header="Game library" ShortName="Library">
                    <StackPanel>
                        <TextBlock Text="Which launchers to look in for installed games." Style="{StaticResource Text.Dim}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Stores}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,12,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox IsChecked="{Binding WriteSteamLaunchOptions}" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Keep Steam launch options up to date" FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="Games start through Optimus-Vibe even from Steam or Big Picture. Steam must be closed to write them."
                                     Foreground="{DynamicResource TextDimBrush}" FontSize="14" />
                            </TextBlock>
                        </CheckBox>

                        <TextBlock Text="Start in" Style="{StaticResource Text.H3}" Margin="0,22,0,10" />
                        <ItemsControl ItemsSource="{Binding Modes}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                                    <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsOn}" Margin="0,0,10,0" VerticalAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.SetModeCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Dim}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== appearance -->
                <views:SettingsSection x:Name="AppearanceCard" Header="Appearance" ShortName="Look">
                    <StackPanel>
                        <TextBlock Text="The colours and the layout density for this machine. A change applies at once." Style="{StaticResource Text.Dim}" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Themes}" Focusable="False" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeOptionViewModel}">
                                    <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsOn}" Margin="0,0,10,0" VerticalAlignment="Stretch" Padding="14"
                                            AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.SetThemeCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <!-- mini preview: page, glow, a card with two text lines, an accent pill and the feature colour -->
                                            <Border Height="{DynamicResource ThemePreviewHeight}" CornerRadius="16" Background="{Binding PageBrush}" ClipToBounds="True">
                                                <Grid>
                                                    <Border Background="{Binding GlowBrush}" />
                                                    <Border Background="{Binding PatternBrush}" />
                                                    <Border Margin="12" CornerRadius="12" Background="{Binding CardBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" Padding="12,10">
                                                        <Grid>
                                                            <StackPanel VerticalAlignment="Top">
                                                                <Border Height="8" Width="86" CornerRadius="4" HorizontalAlignment="Left" Background="{Binding TextBrush}" />
                                                                <Border Height="6" Width="58" CornerRadius="3" HorizontalAlignment="Left" Margin="0,7,0,0" Background="{Binding TextFaintBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                                <Border Height="16" Width="52" CornerRadius="8" Background="{Binding AccentBrush}" />
                                                                <Border Height="16" Width="34" CornerRadius="8" Margin="8,0,0,0" Background="{Binding FeatureBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="2,12,2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentTextBrush}"
                                                           Visibility="{Binding IsOn, Converter={StaticResource VisibleWhen}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Dim}" Margin="2,2,2,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Layout" Style="{StaticResource Text.H3}" Margin="0,22,0,10" />
                        <ItemsControl ItemsSource="{Binding Densities}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                                    <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsOn}" Margin="0,0,10,0" VerticalAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.SetDensityCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Dim}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== devices -->
                <views:SettingsSection x:Name="DevicesCard" Header="Devices" ShortName="Devices">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0">
                            <Run Text="Optimus-Vibe treats this machine as" />
                            <Run Text="{Binding DeviceName, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" /><Run Text="." />
                            <Run Text="The first device below whose match rules fit is the one used, so order matters." />
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Devices.Items}" Focusable="False" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceItemViewModel}">
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8" Padding="20,14,12,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="10,2,10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}">
                                                        <TextBlock Text="This device" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding IdLine}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding IdLine}" />
                                                <TextBlock Text="{Binding PresetsFromText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasPresetsFrom, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Button.Icon}" IsEnabled="{Binding CanMoveUp}" ToolTip="Move up (checked earlier)" AutomationProperties.Name="Move up"
                                                        Command="{Binding DataContext.Devices.MoveUpCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE70E;" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Icon}" IsEnabled="{Binding CanMoveDown}" ToolTip="Move down (checked later)" AutomationProperties.Name="Move down"
                                                        Command="{Binding DataContext.Devices.MoveDownCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE70D;" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Icon}" ToolTip="Rename" AutomationProperties.Name="Rename"
                                                        Command="{Binding DataContext.Devices.RenameCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE8AC;" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Icon}" ToolTip="Edit" AutomationProperties.Name="Edit"
                                                        Command="{Binding DataContext.Devices.EditCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE70F;" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Icon}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                                        Command="{Binding DataContext.Devices.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- delete confirmation -->
                        <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8" Visibility="{Binding Devices.HasPendingDelete, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Devices.DeleteText}" Style="{StaticResource Text.Body}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource Button.Danger}" Command="{Binding Devices.ConfirmDeleteCommand}" Margin="0,0,8,0"
                                            input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Delete device" Content="Delete" />
                                    <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding Devices.CancelDeleteCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,4,0,0" Visibility="{Binding Devices.IsFormOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding Devices.AddThisCommand}" Margin="0,0,8,0" Content="Add this device"
                                    ToolTip="Look at this machine's hardware and fill the form in" AutomationProperties.Name="Add this device" />
                            <Button Command="{Binding Devices.AddManualCommand}" Content="Add another…" ToolTip="Describe a device by hand"
                                    AutomationProperties.Name="Add another device" />
                        </WrapPanel>

                        <!-- the form: add / edit / rename -->
                        <Border x:Name="DeviceForm" Style="{StaticResource Card.Inset}" Background="{DynamicResource InsetDeepBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Margin="0,4,0,0" Padding="22,18"
                                Visibility="{Binding Devices.IsFormOpen, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Devices.FormTitle}" Style="{StaticResource Text.H3}" />
                                <TextBlock Text="{Binding Devices.FormHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding Devices.HasFormHint, Converter={StaticResource VisibleWhen}}" />

                                <TextBlock Text="Name" Style="{StaticResource Text.Dim}" Margin="4,16,0,6" />
                                <TextBox Text="{Binding Devices.Name, UpdateSourceTrigger=PropertyChanged}" input:FocusCue.FocusWhenShown="True"
                                         AutomationProperties.Name="Device name" />

                                <StackPanel Visibility="{Binding Devices.IsRename, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                    <TextBlock Margin="4,14,0,6" Style="{StaticResource Text.Dim}">
                                        <Run Text="Id" />
                                        <Run Text="(kebab-case; can't change later)" Foreground="{DynamicResource TextFaintBrush}" FontSize="13" />
                                    </TextBlock>
                                    <TextBox Text="{Binding Devices.Id, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Devices.IdEditable}"
                                             FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Device id" />
                                    <TextBlock Text="{Binding Devices.IdError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource DangerBrush}" Margin="4,6,0,0"
                                               Visibility="{Binding Devices.HasIdError, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding Devices.ShowFullForm, Converter={StaticResource VisibleWhen}}">
                                    <!-- match rules -->
                                    <TextBlock Margin="4,18,0,2" Style="{StaticResource Text.Dim}">
                                        <Run Text="Match rules" />
                                        <Run Text="(all must fit; * and ? are wildcards; click a key to change it)" Foreground="{DynamicResource TextFaintBrush}" FontSize="13" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Devices.Rules}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MatchRowViewModel}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Command="{Binding CycleKeyCommand}" Content="{Binding Key}" Margin="0,0,8,0" ToolTip="Change what is compared"
                                                            AutomationProperties.Name="Match key" />
                                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                                             AutomationProperties.Name="Match value" />
                                                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding RemoveCommand}" ToolTip="Remove this rule" Margin="6,0,0,0"
                                                            AutomationProperties.Name="Remove rule">
                                                        <TextBlock Text="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No rules: this device is only used when you pick it by hand." Style="{StaticResource Text.Caption}" Margin="4,0,0,8"
                                               Visibility="{Binding Devices.HasRules, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding Devices.AddRuleCommand}" Margin="0,0,12,0" Content="Add a rule"
                                                AutomationProperties.Name="Add a match rule" />
                                        <CheckBox IsChecked="{Binding Devices.UseMachineName}" Content="{Binding Devices.MachineToggleText}" />
                                    </WrapPanel>

                                    <!-- display -->
                                    <TextBlock Margin="4,18,0,6" Style="{StaticResource Text.Dim}">
                                        <Run Text="Display mode" />
                                        <Run Text="(used by presets that say display: inherit; leave empty to keep the screen as it is)" Foreground="{DynamicResource TextFaintBrush}" FontSize="13" />
                                    </TextBlock>
                                    <WrapPanel>
                                        <TextBox Text="{Binding Devices.DisplayWidth, UpdateSourceTrigger=PropertyChanged}" Width="118" TextAlignment="Center" AutomationProperties.Name="Width" ToolTip="Width" />
                                        <TextBlock Text="×" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBox Text="{Binding Devices.DisplayHeight, UpdateSourceTrigger=PropertyChanged}" Width="118" TextAlignment="Center" AutomationProperties.Name="Height" ToolTip="Height" />
                                        <TextBlock Text="@" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBox Text="{Binding Devices.DisplayRefresh, UpdateSourceTrigger=PropertyChanged}" Width="104" TextAlignment="Center" AutomationProperties.Name="Refresh rate" ToolTip="Refresh rate (Hz)" />
                                        <TextBlock Text="Hz" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="10,0,16,0" />
                                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding Devices.UseCurrentDisplayCommand}" Content="Use the current mode"
                                                AutomationProperties.Name="Use the current display mode" />
                                    </WrapPanel>

                                    <!-- driver -->
                                    <TextBlock Text="Graphics driver" Style="{StaticResource Text.Dim}" Margin="4,18,0,6" />
                                    <ItemsControl ItemsSource="{Binding Devices.Drivers}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                                                <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsOn}" Margin="0,0,8,8" MinWidth="110" Padding="20,10" MinHeight="46"
                                                        AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Hint}"
                                                        Command="{Binding DataContext.Devices.SetDriverCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- default preset -->
                                    <TextBlock Margin="4,10,0,6" Style="{StaticResource Text.Dim}">
                                        <Run Text="Default preset" />
                                        <Run Text="(used for a game until you pick one: quality, performance, battery...)" Foreground="{DynamicResource TextFaintBrush}" FontSize="13" />
                                    </TextBlock>
                                    <TextBox Text="{Binding Devices.DefaultPreset, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"
                                             FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Default preset" />

                                    <!-- presetsFrom -->
                                    <TextBlock Margin="4,18,0,6" Style="{StaticResource Text.Dim}">
                                        <Run Text="Use presets from" />
                                        <Run Text="(for games with no presets of their own for this device)" Foreground="{DynamicResource TextFaintBrush}" FontSize="13" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Devices.PresetsFromOptions}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                                                <Button Style="{StaticResource Button.Choice}" Tag="{Binding IsOn}" Margin="0,0,8,8" MinWidth="110" Padding="20,10" MinHeight="46"
                                                        AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Hint}"
                                                        Command="{Binding DataContext.Devices.SetPresetsFromCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button Style="{StaticResource Button.Primary}" Command="{Binding Devices.SaveCommand}" Content="{Binding Devices.SaveLabel}" MinWidth="130"
                                            Margin="0,0,8,0" AutomationProperties.Name="Save device" />
                                    <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding Devices.CancelCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Use a different device profile" Style="{StaticResource Text.H3}" Margin="0,22,0,10" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding DeviceChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:DeviceChoice}">
                                        <Button Content="{Binding Name}" Margin="0,0,8,8" MinWidth="120"
                                                Command="{Binding DataContext.ForceDeviceCommand, ElementName=Root}" CommandParameter="{Binding Id}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Auto-detect" Style="{StaticResource Button.Quiet}" Command="{Binding AutoDetectDeviceCommand}" Margin="0,0,8,8"
                                    ToolTip="Forget the forced profile and match devices.yaml again" />
                        </WrapPanel>

                        <ToggleButton x:Name="AboutToggle" Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                      AutomationProperties.Name="About this device">
                            <TextBlock>
                                <Run Text="&#xE946;" FontFamily="{StaticResource IconFont}" />
                                <Run Text="About this device" />
                            </TextBlock>
                        </ToggleButton>
                        <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0"
                                Visibility="{Binding IsChecked, ElementName=AboutToggle, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceReason}" Style="{StaticResource Text.Dim}"
                                           Visibility="{Binding DeviceReason, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Text="{Binding DeviceDescription}" Style="{StaticResource Text.Dim}" Margin="0,6,0,0"
                                           Visibility="{Binding DeviceDescription, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0">
                                    <Run Text="Config folder" />
                                    <Run Text="{Binding ConfigRoot, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                                    <Run Text="Optimus-Vibe" />
                                    <Run Text="{Binding AppVersion, Mode=OneWay}" />
                                    <Run Text="· updates come from" />
                                    <Run Text="{Binding Updates.RepoText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </views:SettingsSection>

                <!-- ======================================================== report a problem -->
                <views:SettingsSection Header="Something not right?" ShortName="Report">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0"
                                   Text="Describe it, preview what would be sent, then file it as an issue." />
                        <Button Command="{Binding OpenReportCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="Report a problem"
                                Content="Report a problem" />
                    </StackPanel>
                </views:SettingsSection>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
