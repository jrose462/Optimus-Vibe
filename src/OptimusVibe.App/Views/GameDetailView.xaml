<UserControl x:Class="OptimusVibe.App.Views.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:OptimusVibe.App.Input"
             xmlns:views="clr-namespace:OptimusVibe.App.Views"
             xmlns:svc="clr-namespace:OptimusVibe.App.Services"
             xmlns:vm="clr-namespace:OptimusVibe.App.ViewModels">
    <!-- DataContext: GameDetailViewModel. One scrolling page: title, summary card, Recommended / Manual saves tabs. -->
    <UserControl.Resources>

        <!-- Card background: a touch bluer when this preset is the one in use. -->
        <Style x:Key="PresetCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardActiveBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A recommended preset as a tile: fixed width on the desktop (wrapping), one of two columns when compact. -->
        <Style x:Key="PresetCard.Tile" TargetType="Border" BasedOn="{StaticResource PresetCard}">
            <Setter Property="Width" Value="{DynamicResource PresetCardWidth}" />
            <Setter Property="MinHeight" Value="{DynamicResource PresetCardMinHeight}" />
            <Setter Property="Margin" Value="{DynamicResource PresetCardMargin}" />
        </Style>

        <!-- Compact: two lines of the description; the whole text while the card has focus (or the mouse is on it). -->
        <Style x:Key="PresetDescription" TargetType="TextBlock" BasedOn="{StaticResource Text.Dim}">
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="MaxHeight" Value="38" />
                </Trigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="TextTrimming" Value="None" />
                    <Setter Property="MaxHeight" Value="1000" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="TextTrimming" Value="None" />
                    <Setter Property="MaxHeight" Value="1000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetGrid" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- the three summary metrics: a column on the desktop, one row when compact -->
        <Style x:Key="SummaryMetrics" TargetType="WrapPanel">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0,18,0,0" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Margin" Value="22,0,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="views:MetricRow">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Margin" Value="0,0,10,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "What you want from it": a title and the text on the desktop; just two lines of the text when compact -->
        <Style x:Key="IntentTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
            <Setter Property="Foreground" Value="{DynamicResource FeatureTextBrush}" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IntentText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{DynamicResource FeatureTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MaxHeight" Value="40" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SyncEvidence" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AskDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- the lead sentence: under the title, or on the title's line when compact -->
        <Style x:Key="GameLead" TargetType="TextBlock" BasedOn="{StaticResource Text.Lead}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Margin" Value="18,0,0,3" />
                    <Setter Property="MaxWidth" Value="100000" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="FontSize" Value="{DynamicResource DimSize}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======================================================== recommended preset card -->
        <DataTemplate x:Key="RecommendedCard" DataType="{x:Type vm:PresetCardViewModel}">
            <Border Style="{StaticResource PresetCard.Tile}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <WrapPanel>
                            <Button AutomationProperties.Name="Use" Style="{StaticResource Button.Primary}" Command="{Binding UseCommand}" Margin="0,0,8,0" MinWidth="96"
                                    ToolTip="Remember this preset for this game on this device. It is applied on the next launch.">
                                <TextBlock Text="{Binding UseText}" />
                            </Button>
                            <Button Content="Apply now" Command="{Binding ApplyCommand}" Margin="0,0,8,0"
                                    ToolTip="Write these settings into the game now (you see the changes first)" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleMoreCommand}" AutomationProperties.Name="More" ToolTip="More">
                                <TextBlock Text="&#xE712;" />
                            </Button>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsMoreOpen, Converter={StaticResource VisibleWhen}}">
                            <Button Content="Preview changes" Style="{StaticResource Button.Quiet}" Command="{Binding PreviewCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding StateLine}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding StateLine, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource PresetDescription}" Margin="0,12,0,0"
                                   Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ======================================================== manual save card -->
        <DataTemplate x:Key="ManualCard" DataType="{x:Type vm:PresetCardViewModel}">
            <Border Margin="{DynamicResource CardMargin}" Style="{StaticResource PresetCard}">
                <StackPanel>
                    <!-- title / rename -->
                    <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding StateLine}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding StateLine, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <Grid Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="460" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" FontSize="17"
                                 input:FocusCue.FocusWhenShown="True">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Save name" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                Command="{Binding ConfirmRenameCommand}" />
                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource Button.Quiet}" Margin="6,0,0,0" Command="{Binding CancelRenameCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Visibility="{Binding MetaText, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource PresetDescription}" Margin="0,10,0,0"
                               Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />

                    <!-- actions -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsIdle, Converter={StaticResource VisibleWhen}}">
                        <WrapPanel>
                            <Button AutomationProperties.Name="Use" Style="{StaticResource Button.Primary}" Command="{Binding UseCommand}" Margin="0,0,8,0" MinWidth="96"
                                    ToolTip="Remember this save for this game on this device. It is applied on the next launch.">
                                <TextBlock Text="{Binding UseText}" />
                            </Button>
                            <Button Content="Apply now" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleMoreCommand}" AutomationProperties.Name="More" ToolTip="More">
                                <TextBlock Text="&#xE712;" />
                            </Button>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsMoreOpen, Converter={StaticResource VisibleWhen}}">
                            <Button Content="Preview changes" Style="{StaticResource Button.Quiet}" Command="{Binding PreviewCommand}" />
                            <Button AutomationProperties.Name="Update from current" Style="{StaticResource Button.Quiet}" Command="{Binding UpdateFromCurrentCommand}"
                                    Content="Update from current settings"
                                    ToolTip="Overwrite this save with the game's current settings (and make it active)" />
                            <Button AutomationProperties.Name="Rename" Style="{StaticResource Button.Quiet}" Command="{Binding BeginRenameCommand}" Content="Rename" />
                            <Button AutomationProperties.Name="Delete" Style="{StaticResource Button.Quiet}" Command="{Binding BeginDeleteCommand}" Content="Delete"
                                    Foreground="{DynamicResource DangerBrush}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- inline delete confirmation -->
                    <Border Style="{StaticResource Card.Inset}" Background="{DynamicResource DangerSoftBrush}" Margin="0,16,0,0"
                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Delete" />
                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="? It is removed from your config repo too." />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Keep it" Command="{Binding CancelDeleteCommand}" Margin="0,0,8,0"
                                        input:FocusCue.FocusWhenShown="True" />
                                <Button Content="Delete" AutomationProperties.Name="Confirm delete" Style="{StaticResource Button.Danger}" Command="{Binding ConfirmDeleteCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FilePreview" DataType="{x:Type vm:FilePreviewItem}">
            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H3}">
                        <Run Text="{Binding Id, Mode=OneWay}" />
                        <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextDimBrush}" FontSize="14" />
                    </TextBlock>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource TextFaintBrush}"
                               FontSize="12" Margin="0,4,0,0" Visibility="{Binding Path, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding SkipReason}" Style="{StaticResource Text.Dim}" Margin="0,6,0,0"
                               Visibility="{Binding IsSkipped, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0" Focusable="False"
                                  Visibility="{Binding HasChanges, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeyChangeItem}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Mono}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Current}" Style="{StaticResource Text.Mono}"
                                               Foreground="{DynamicResource TextFaintBrush}" />
                                    <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource TextFaintBrush}" Margin="10,2" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="3" Text="{Binding Target}" Style="{StaticResource Text.Mono}"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ============================================================ main -->
        <ScrollViewer x:Name="Main" VerticalScrollBarVisibility="Auto" Focusable="False"
                      IsEnabled="{Binding IsPreviewOpen, Converter={StaticResource Not}}">
            <StackPanel Margin="{DynamicResource DetailMargin}">

                <!-- title + one friendly sentence (compact: on one line) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding Lead}" Style="{StaticResource GameLead}"
                               Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}" />
                </Grid>

                <!-- summary + the one feature card (compact: the metrics sit in one row beside the title) -->
                <Grid Margin="{DynamicResource BlockGap}" Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Text.H2}" VerticalAlignment="Center">
                                <Run Text="Active on this" />
                                <Run Text="{Binding DeviceFriendly, Mode=OneWay}" />
                            </TextBlock>
                            <WrapPanel Style="{StaticResource SummaryMetrics}">
                                <views:MetricRow Glyph="&#xE735;" IconBrush="{DynamicResource MetricGreenBrush}" Value="{Binding ActivePresetLabel}" Unit="preset" />
                                <views:MetricRow Glyph="&#xE9D9;" IconBrush="{DynamicResource MetricCyanBrush}" Value="{Binding TargetFpsValue}" Unit="fps target" />
                                <views:MetricRow Glyph="&#xE713;" IconBrush="{DynamicResource MetricPurpleBrush}" Value="{Binding SettingsCountValue}" Unit="settings" Margin="0" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card.Feature}" Margin="16,0,0,0" Width="{DynamicResource IntentCardWidth}"
                            Visibility="{Binding HasIntent, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="What you want from it" Style="{StaticResource IntentTitle}" />
                            <Grid>
                                <!-- the text; click / A edits it -->
                                <Button Style="{StaticResource Button.Quiet}" Command="{Binding EditIntentCommand}" Padding="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Edit what you want from it" ToolTip="{Binding IntentDisplay}"
                                        Visibility="{Binding IsEditingIntent, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                    <TextBlock Text="{Binding IntentDisplay}" Style="{StaticResource IntentText}" TextWrapping="Wrap" />
                                </Button>
                                <!-- editing -->
                                <StackPanel VerticalAlignment="Bottom" Visibility="{Binding IsEditingIntent, Converter={StaticResource VisibleWhen}}">
                                    <TextBox Text="{Binding IntentDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding IntentMaxLength, Mode=OneTime}"
                                             TextWrapping="Wrap" AcceptsReturn="False" MinHeight="64" Margin="0,12,0,0"
                                             AutomationProperties.Name="What you want from it" input:FocusCue.FocusWhenShown="True">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SaveIntentCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource Button.Primary}" Content="Save" Command="{Binding SaveIntentCommand}" MinWidth="96"
                                                AutomationProperties.Name="Save what you want from it" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource Button.Quiet}" Content="Cancel" Command="{Binding CancelIntentCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- status row: game lab on the left, settings sync + per-game options on the right; stacked when narrow (code-behind) -->
                <Grid x:Name="StatusRow" Margin="{DynamicResource BlockGapMd}" SizeChanged="OnStatusRowSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StatusLeft" Width="*" />
                        <ColumnDefinition x:Name="StatusGap" Width="0" />
                        <ColumnDefinition x:Name="StatusRight" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!-- game lab: the game's health, one suggested action, the rest under More -->
                <views:LabGamePanel x:Name="LabPanel" DataContext="{Binding Lab}" VerticalAlignment="Top"
                                    Visibility="{Binding DataContext.HasGame, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />

                <StackPanel x:Name="StatusSide" Grid.Row="1" Margin="{DynamicResource BlockGapMd}">
                <!-- settings sync: do this game's graphics settings travel between machines? -->
                <Border x:Name="SyncCard" Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="760"
                        Visibility="{Binding HasSync, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MetricIcon}" Background="{DynamicResource MetricCyanBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource MetricGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource Text.H3}">
                                <Run Text="Settings sync" />
                                <Run Text="{Binding SyncSummary, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextDimBrush}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SyncEvidence}" Margin="0,6,0,0" Style="{StaticResource SyncEvidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasSyncAttention, Converter={StaticResource VisibleWhen}}">
                                <Border Style="{StaticResource Dot.Attention}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding SyncAttentionText}" Style="{StaticResource Text.Body}" MaxWidth="600" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- post-game prompt: per game, this device only -->
                <CheckBox IsChecked="{Binding AskToSaveAfterPlaying}" Margin="{DynamicResource AskMargin}" HorizontalAlignment="Left"
                          Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}"
                          ToolTip="After you quit, offer to keep settings you changed in the game. Turn off to stop asking for this game on this device.">
                    <StackPanel>
                        <TextBlock Text="Ask me to save after playing" FontWeight="SemiBold" />
                        <TextBlock Text="When settings change in the game, offer to keep them as a save." Style="{StaticResource AskDetail}" />
                    </StackPanel>
                </CheckBox>

                <!-- Big Picture (TV): per game opt-out and the current state -->
                <CheckBox IsChecked="{Binding NeverBigPicture}" Margin="{DynamicResource AskMargin}" HorizontalAlignment="Left"
                          Visibility="{Binding HasBigPicturePreset, Converter={StaticResource VisibleWhen}}"
                          ToolTip="Keep this game on its normal preset even when a 4K TV or a 4K stream is detected (this device only).">
                    <StackPanel>
                        <TextBlock Text="Never use Big Picture for this game" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BigPictureText}" Style="{StaticResource AskDetail}"
                                   Visibility="{Binding HasBigPictureText, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </CheckBox>
                </StackPanel>
                </Grid>

                <!-- config error -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource BlockGap}" HorizontalAlignment="Left" MaxWidth="760"
                        Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H2}" Text="This game's config needs a fix" />
                        <TextBlock Text="Fix the game's yaml, then refresh." Style="{StaticResource Text.Dim}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource TextFaintBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- tabs -->
                <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTabIndex}" Margin="{DynamicResource TabsMargin}"
                            Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}">
                    <TabItem Header="Recommended">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource RecommendedCard}" Style="{StaticResource PresetGrid}"
                                          Visibility="{Binding HasRecommended, Converter={StaticResource VisibleWhen}}" />

                            <!-- empty state -->
                            <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="760"
                                    Visibility="{Binding HasRecommended, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.H2}">
                                        <Run Text="No presets for this" />
                                        <Run Text="{Binding DeviceFriendly, Mode=OneWay}" />
                                        <Run Text="yet" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                                               Text="Ask Claude to research this game's settings and write presets for this device, then sync and refresh. Meanwhile you can tune it in the game and keep the result under Manual saves." />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Command="{Binding UseDefaultCommand}"
                                    Visibility="{Binding CanUseDefault, Converter={StaticResource VisibleWhen}}">
                                <TextBlock>
                                    <Run Text="&#xE777;" FontFamily="{StaticResource IconFont}" />
                                    <Run Text="Back to the device default" />
                                    <Run Text="{Binding DefaultPresetName, Mode=OneWay, StringFormat=({0})}" />
                                </TextBlock>
                            </Button>

                            <!-- provenance, out of the way -->
                            <ToggleButton x:Name="AboutPresets" Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                          Visibility="{Binding HasRecommendation, Converter={StaticResource VisibleWhen}}">
                                <TextBlock>
                                    <Run Text="&#xE946;" FontFamily="{StaticResource IconFont}" />
                                    <Run Text="About these presets" />
                                </TextBlock>
                            </ToggleButton>
                            <StackPanel Margin="16,2,0,0"
                                        Visibility="{Binding IsChecked, ElementName=AboutPresets, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource Text.Caption}" />
                                <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <TextBlock>
                                <Run Text="Manual saves" />
                                <Run Text="{Binding Manual.Count, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" />
                            </TextBlock>
                        </TabItem.Header>
                        <StackPanel>
                            <!-- save current -->
                            <Border Style="{StaticResource Card}" Margin="{DynamicResource CardMargin}">
                                <StackPanel>
                                    <Grid Visibility="{Binding IsSaveFormOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Tuned something in the game?" Style="{StaticResource Text.H2}" />
                                            <TextBlock Style="{StaticResource Text.Dim}" Margin="0,6,0,0"
                                                       Text="Save the game's current settings as your own preset for this device. It becomes the active one." />
                                        </StackPanel>
                                        <Button Grid.Column="1" AutomationProperties.Name="Save current settings" Style="{StaticResource Button.Primary}" Command="{Binding OpenSaveFormCommand}"
                                                Content="Save current settings" />
                                    </Grid>

                                    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Visibility="{Binding IsSaveFormOpen, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="Save current settings" Style="{StaticResource Text.H2}" />
                                        <TextBlock Text="Name" Style="{StaticResource Text.Dim}" Margin="0,14,0,6" />
                                        <TextBox Text="{Binding NewSaveName, UpdateSourceTrigger=PropertyChanged}" FontSize="17" MinWidth="420"
                                                 HorizontalAlignment="Stretch" input:FocusCue.FocusWhenShown="True" />
                                        <TextBlock Text="Notes (optional)" Style="{StaticResource Text.Dim}" Margin="0,12,0,6" />
                                        <TextBox Text="{Binding NewSaveNotes, UpdateSourceTrigger=PropertyChanged}" MinWidth="420"
                                                 HorizontalAlignment="Stretch" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button AutomationProperties.Name="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCurrentCommand}" MinWidth="120"
                                                    Content="Save" />
                                            <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CancelSaveFormCommand}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,12"
                                       Visibility="{Binding HasLastSync, Converter={StaticResource VisibleWhen}}" />

                            <ItemsControl ItemsSource="{Binding Manual}" ItemTemplate="{StaticResource ManualCard}" Focusable="False" />

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding HasManual, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.H2}" Text="No saves yet" />
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,8,0,0"
                                               Text="Play with a preset, adjust graphics in the game's own menu, quit, then save here. Optimus-Vibe also offers to save when it notices changes after a launch." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ diff / confirm panel -->
        <Grid x:Name="Overlay" DataContext="{Binding Preview}" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              Visibility="{Binding DataContext.IsPreviewOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}">
            <Border Background="{DynamicResource BackdropBrush}" />
            <Border Style="{StaticResource Overlay.Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.OverlayTitle}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Lead}" Margin="0,6,0,16" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding AlsoUse}" Content="Also use this preset from now on"
                                  Visibility="{Binding ShowAlsoUse, Converter={StaticResource VisibleWhen}}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- apply mode -->
                            <Button Style="{StaticResource Button.Quiet}" Command="{Binding CloseCommand}" Margin="0,0,6,0" AutomationProperties.Name="Cancel"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}}">
                                <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Confirm apply" Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" MinWidth="130"
                                    input:FocusCue.FocusWhenShown="True" Content="Apply now"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}}" />
                            <!-- preview mode -->
                            <Button Content="Apply now…" Command="{Binding SwitchToApplyCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding CloseCommand}" MinWidth="110" AutomationProperties.Name="Close"
                                    input:FocusCue.FocusWhenShown="True"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Close" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FilePreview}" Focusable="False" />
                            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,10"
                                    Visibility="{Binding HasDriverLines, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Text="Graphics driver" Style="{StaticResource Text.H3}" />
                                    <ItemsControl ItemsSource="{Binding DriverLines}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding DisplayNote}" Style="{StaticResource Text.Dim}" Margin="2,0,0,6"
                                       Visibility="{Binding HasDisplayNote, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
