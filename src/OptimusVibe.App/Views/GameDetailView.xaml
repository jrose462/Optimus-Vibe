<UserControl x:Class="OptimusVibe.App.Views.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:OptimusVibe.App.Input"
             xmlns:views="clr-namespace:OptimusVibe.App.Views"
             xmlns:vm="clr-namespace:OptimusVibe.App.ViewModels">
    <!-- DataContext: GameDetailViewModel. One scrolling page: title, summary card, Recommended / Manual saves tabs. -->
    <UserControl.Resources>

        <!-- Card background: a touch bluer when this preset is the one in use. -->
        <Style x:Key="PresetCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardActiveBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ======================================================== recommended preset card -->
        <DataTemplate x:Key="RecommendedCard" DataType="{x:Type vm:PresetCardViewModel}">
            <Border Width="372" MinHeight="230" Margin="0,0,16,16" Style="{StaticResource PresetCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <WrapPanel>
                            <Button AutomationProperties.Name="Use" Style="{StaticResource Button.Primary}" Command="{Binding UseCommand}" Margin="0,0,8,0" MinWidth="96"
                                    ToolTip="Remember this preset for this game on this device. It is applied on the next launch.">
                                <TextBlock Text="{Binding UseText}" />
                            </Button>
                            <Button Content="Apply now" Command="{Binding ApplyCommand}" Margin="0,0,8,0"
                                    ToolTip="Write these settings into the game now (you see the changes first)" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleMoreCommand}" AutomationProperties.Name="More" ToolTip="More">
                                <TextBlock Text="&#xE712;" />
                            </Button>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsMoreOpen, Converter={StaticResource VisibleWhen}}">
                            <Button Content="Preview changes" Style="{StaticResource Button.Quiet}" Command="{Binding PreviewCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.H2}" FontSize="22" />
                        <TextBlock Text="{Binding StateLine}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding StateLine, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Dim}" Margin="0,12,0,0"
                                   Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ======================================================== manual save card -->
        <DataTemplate x:Key="ManualCard" DataType="{x:Type vm:PresetCardViewModel}">
            <Border Margin="0,0,0,16" Style="{StaticResource PresetCard}">
                <StackPanel>
                    <!-- title / rename -->
                    <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.H2}" FontSize="22" />
                        <TextBlock Text="{Binding StateLine}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding StateLine, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <Grid Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="460" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" FontSize="17"
                                 input:FocusCue.FocusWhenShown="True">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Save name" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                Command="{Binding ConfirmRenameCommand}" />
                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource Button.Quiet}" Margin="6,0,0,0" Command="{Binding CancelRenameCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Visibility="{Binding MetaText, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                               Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />

                    <!-- actions -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsIdle, Converter={StaticResource VisibleWhen}}">
                        <WrapPanel>
                            <Button AutomationProperties.Name="Use" Style="{StaticResource Button.Primary}" Command="{Binding UseCommand}" Margin="0,0,8,0" MinWidth="96"
                                    ToolTip="Remember this save for this game on this device. It is applied on the next launch.">
                                <TextBlock Text="{Binding UseText}" />
                            </Button>
                            <Button Content="Apply now" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleMoreCommand}" AutomationProperties.Name="More" ToolTip="More">
                                <TextBlock Text="&#xE712;" />
                            </Button>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsMoreOpen, Converter={StaticResource VisibleWhen}}">
                            <Button Content="Preview changes" Style="{StaticResource Button.Quiet}" Command="{Binding PreviewCommand}" />
                            <Button AutomationProperties.Name="Update from current" Style="{StaticResource Button.Quiet}" Command="{Binding UpdateFromCurrentCommand}"
                                    Content="Update from current settings"
                                    ToolTip="Overwrite this save with the game's current settings (and make it active)" />
                            <Button AutomationProperties.Name="Rename" Style="{StaticResource Button.Quiet}" Command="{Binding BeginRenameCommand}" Content="Rename" />
                            <Button AutomationProperties.Name="Delete" Style="{StaticResource Button.Quiet}" Command="{Binding BeginDeleteCommand}" Content="Delete"
                                    Foreground="{StaticResource DangerBrush}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- inline delete confirmation -->
                    <Border Style="{StaticResource Card.Inset}" Background="{StaticResource DangerSoftBrush}" Margin="0,16,0,0"
                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Delete" />
                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="? It is removed from your config repo too." />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Keep it" Command="{Binding CancelDeleteCommand}" Margin="0,0,8,0"
                                        input:FocusCue.FocusWhenShown="True" />
                                <Button Content="Delete" AutomationProperties.Name="Confirm delete" Style="{StaticResource Button.Danger}" Command="{Binding ConfirmDeleteCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FilePreview" DataType="{x:Type vm:FilePreviewItem}">
            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H3}">
                        <Run Text="{Binding Id, Mode=OneWay}" />
                        <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource TextDimBrush}" FontSize="14" />
                    </TextBlock>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource TextFaintBrush}"
                               FontSize="12" Margin="0,4,0,0" Visibility="{Binding Path, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding SkipReason}" Style="{StaticResource Text.Dim}" Margin="0,6,0,0"
                               Visibility="{Binding IsSkipped, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0" Focusable="False"
                                  Visibility="{Binding HasChanges, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeyChangeItem}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Mono}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Current}" Style="{StaticResource Text.Mono}"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="10,2" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="3" Text="{Binding Target}" Style="{StaticResource Text.Mono}"
                                               Foreground="{StaticResource AccentTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ============================================================ main -->
        <ScrollViewer x:Name="Main" VerticalScrollBarVisibility="Auto" Focusable="False"
                      IsEnabled="{Binding IsPreviewOpen, Converter={StaticResource Not}}">
            <StackPanel Margin="32,8,32,12">

                <!-- title + one friendly sentence -->
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding Lead}" Style="{StaticResource Text.Lead}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                           Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}" />

                <!-- summary + the one feature card -->
                <Grid Margin="0,22,0,0" Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.H2}">
                                <Run Text="Active on this" />
                                <Run Text="{Binding DeviceFriendly, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Margin="0,18,0,0">
                                <views:MetricRow Glyph="&#xE735;" IconBrush="{StaticResource MetricGreenBrush}" Value="{Binding ActivePresetLabel}" Unit="preset" Margin="0,0,0,12" />
                                <views:MetricRow Glyph="&#xE9D9;" IconBrush="{StaticResource MetricCyanBrush}" Value="{Binding TargetFpsValue}" Unit="fps target" Margin="0,0,0,12" />
                                <views:MetricRow Glyph="&#xE713;" IconBrush="{StaticResource MetricPurpleBrush}" Value="{Binding SettingsCountValue}" Unit="settings" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card.Feature}" Margin="16,0,0,0" Width="340"
                            Visibility="{Binding HasIntent, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="What you want from it" Style="{StaticResource Text.H2}" Foreground="White" />
                            <TextBlock Text="{Binding IntentDisplay}" Style="{StaticResource Text.Body}" Foreground="White" VerticalAlignment="Bottom" Margin="0,16,0,0" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- settings sync: do this game's graphics settings travel between machines? -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" HorizontalAlignment="Left" MaxWidth="760"
                        Visibility="{Binding HasSync, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MetricIcon}" Background="{StaticResource MetricCyanBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{StaticResource MetricGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource Text.H3}">
                                <Run Text="Settings sync" />
                                <Run Text="{Binding SyncSummary, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource TextDimBrush}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SyncEvidence}" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasSyncAttention, Converter={StaticResource VisibleWhen}}">
                                <Border Style="{StaticResource Dot.Attention}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding SyncAttentionText}" Style="{StaticResource Text.Body}" MaxWidth="600" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- config error -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0" HorizontalAlignment="Left" MaxWidth="760"
                        Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H2}" Text="This game's config needs a fix" />
                        <TextBlock Text="Fix the game's yaml, then refresh." Style="{StaticResource Text.Dim}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource TextFaintBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- tabs -->
                <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,22,0,0"
                            Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}">
                    <TabItem Header="Recommended">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource RecommendedCard}" Focusable="False"
                                          Visibility="{Binding HasRecommended, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- empty state -->
                            <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="760"
                                    Visibility="{Binding HasRecommended, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.H2}">
                                        <Run Text="No presets for this" />
                                        <Run Text="{Binding DeviceFriendly, Mode=OneWay}" />
                                        <Run Text="yet" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                                               Text="Ask Claude to research this game's settings and write presets for this device, then sync and refresh. Meanwhile you can tune it in the game and keep the result under Manual saves." />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Command="{Binding UseDefaultCommand}"
                                    Visibility="{Binding CanUseDefault, Converter={StaticResource VisibleWhen}}">
                                <TextBlock>
                                    <Run Text="&#xE777;" FontFamily="{StaticResource IconFont}" />
                                    <Run Text="Back to the device default" />
                                    <Run Text="{Binding DefaultPresetName, Mode=OneWay, StringFormat=({0})}" />
                                </TextBlock>
                            </Button>

                            <!-- provenance, out of the way -->
                            <ToggleButton x:Name="AboutPresets" Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                          Visibility="{Binding HasRecommendation, Converter={StaticResource VisibleWhen}}">
                                <TextBlock>
                                    <Run Text="&#xE946;" FontFamily="{StaticResource IconFont}" />
                                    <Run Text="About these presets" />
                                </TextBlock>
                            </ToggleButton>
                            <StackPanel Margin="16,2,0,0"
                                        Visibility="{Binding IsChecked, ElementName=AboutPresets, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource Text.Caption}" />
                                <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <TextBlock>
                                <Run Text="Manual saves" />
                                <Run Text="{Binding Manual.Count, Mode=OneWay}" Foreground="{StaticResource TextFaintBrush}" />
                            </TextBlock>
                        </TabItem.Header>
                        <StackPanel>
                            <!-- save current -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Visibility="{Binding IsSaveFormOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Tuned something in the game?" Style="{StaticResource Text.H2}" />
                                            <TextBlock Style="{StaticResource Text.Dim}" Margin="0,6,0,0"
                                                       Text="Save the game's current settings as your own preset for this device. It becomes the active one." />
                                        </StackPanel>
                                        <Button Grid.Column="1" AutomationProperties.Name="Save current settings" Style="{StaticResource Button.Primary}" Command="{Binding OpenSaveFormCommand}"
                                                Content="Save current settings" />
                                    </Grid>

                                    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Visibility="{Binding IsSaveFormOpen, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="Save current settings" Style="{StaticResource Text.H2}" />
                                        <TextBlock Text="Name" Style="{StaticResource Text.Dim}" Margin="0,14,0,6" />
                                        <TextBox Text="{Binding NewSaveName, UpdateSourceTrigger=PropertyChanged}" FontSize="17" MinWidth="420"
                                                 HorizontalAlignment="Stretch" input:FocusCue.FocusWhenShown="True" />
                                        <TextBlock Text="Notes (optional)" Style="{StaticResource Text.Dim}" Margin="0,12,0,6" />
                                        <TextBox Text="{Binding NewSaveNotes, UpdateSourceTrigger=PropertyChanged}" MinWidth="420"
                                                 HorizontalAlignment="Stretch" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button AutomationProperties.Name="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCurrentCommand}" MinWidth="120"
                                                    Content="Save" />
                                            <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CancelSaveFormCommand}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,12"
                                       Visibility="{Binding HasLastSync, Converter={StaticResource VisibleWhen}}" />

                            <ItemsControl ItemsSource="{Binding Manual}" ItemTemplate="{StaticResource ManualCard}" Focusable="False" />

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding HasManual, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.H2}" Text="No saves yet" />
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,8,0,0"
                                               Text="Play with a preset, adjust graphics in the game's own menu, quit, then save here. Optimus-Vibe also offers to save when it notices changes after a launch." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ diff / confirm panel -->
        <Grid x:Name="Overlay" DataContext="{Binding Preview}" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              Visibility="{Binding DataContext.IsPreviewOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}">
            <Border Background="{StaticResource BackdropBrush}" />
            <Border Style="{StaticResource Card}" MaxWidth="860" Margin="24" VerticalAlignment="Center" Padding="32,28">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" FontSize="28" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Lead}" Margin="0,6,0,16" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding AlsoUse}" Content="Also use this preset from now on"
                                  Visibility="{Binding ShowAlsoUse, Converter={StaticResource VisibleWhen}}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- apply mode -->
                            <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CloseCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}}" />
                            <Button AutomationProperties.Name="Confirm apply" Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" MinWidth="130"
                                    input:FocusCue.FocusWhenShown="True" Content="Apply now"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}}" />
                            <!-- preview mode -->
                            <Button Content="Apply now…" Command="{Binding SwitchToApplyCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <Button Content="Close" Style="{StaticResource Button.Primary}" Command="{Binding CloseCommand}" MinWidth="110"
                                    input:FocusCue.FocusWhenShown="True"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FilePreview}" Focusable="False" />
                            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,10"
                                    Visibility="{Binding HasDriverLines, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Text="Graphics driver" Style="{StaticResource Text.H3}" />
                                    <ItemsControl ItemsSource="{Binding DriverLines}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding DisplayNote}" Style="{StaticResource Text.Dim}" Margin="2,0,0,6"
                                       Visibility="{Binding HasDisplayNote, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
