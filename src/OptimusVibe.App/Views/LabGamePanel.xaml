<UserControl x:Class="OptimusVibe.App.Views.LabGamePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptimusVibe.App.Views"
             xmlns:svc="clr-namespace:OptimusVibe.App.Services"
             xmlns:input="clr-namespace:OptimusVibe.App.Input">
    <!-- DataContext: LabGameViewModel. Request / refresh presets, re-check settings sync, the evidence preview, the request's status.
         Compact: the title, the buttons and "Open issue" share one row. -->
    <UserControl.Resources>
        <!-- under the reason on the desktop, beside it when compact -->
        <Style x:Key="DisabledAction" TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Margin" Value="8,0,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="{DynamicResource LabMaxWidth}">
        <StackPanel>
            <!-- ============================================================ comfortable -->
            <StackPanel Style="{StaticResource Only.Comfortable}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Game lab" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="10,2,10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding ChipLine}">
                            <TextBlock Text="{Binding ChipText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Quiet}" Command="{Binding OpenIssueCommand}" Content="Open issue"
                            Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Open the request on GitHub" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Have Claude research this game's settings from evidence on this PC. It runs in your private config repo." />

                <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding RequestCommand}" Content="{Binding RequestText}" Margin="0,0,8,6"
                            Visibility="{Binding ShowRequest, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Request presets" />
                    <Button Command="{Binding RefreshPresetsCommand}" Content="Refresh presets" Margin="0,0,8,6"
                            Visibility="{Binding ShowRefresh, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Refresh presets" />
                    <Button Command="{Binding SyncCheckCommand}" Content="Re-check settings sync" Margin="0,0,8,6"
                            Visibility="{Binding ShowSyncCheck, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Re-check settings sync" />
                    <Button Command="{Binding TestCommand}" Content="Test preset" Margin="0,0,8,6"
                            Visibility="{Binding ShowTest, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Test preset"
                            ToolTip="Launch the game once with nothing changed and see whether it keeps the preset's settings." />
                    <Button Command="{Binding MapCommand}" Content="Map this game" Margin="0,0,8,6"
                            Visibility="{Binding ShowMap, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Map this game"
                            ToolTip="Launch the game twice, once changing nothing and once changing many graphics options, to find where its settings live." />
                </WrapPanel>
            </StackPanel>

            <!-- ============================================================ compact: one row -->
            <Grid Style="{StaticResource Only.Compact}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            ToolTip="Have Claude research this game's settings from evidence on this PC. It runs in your private config repo.">
                    <TextBlock Text="Game lab" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="10,2,10,3" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding ChipLine}">
                        <TextBlock Text="{Binding ChipText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding RequestCommand}" Content="{Binding RequestText}" Margin="0,2,8,2"
                            Visibility="{Binding ShowRequest, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Request presets" />
                    <Button Command="{Binding RefreshPresetsCommand}" Content="Refresh presets" Margin="0,2,8,2"
                            Visibility="{Binding ShowRefresh, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Refresh presets" />
                    <Button Command="{Binding SyncCheckCommand}" Content="Re-check settings sync" Margin="0,2,8,2"
                            Visibility="{Binding ShowSyncCheck, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Re-check settings sync" />
                    <Button Command="{Binding TestCommand}" Content="Test preset" Margin="0,2,8,2"
                            Visibility="{Binding ShowTest, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Test preset"
                            ToolTip="Launch the game once with nothing changed and see whether it keeps the preset's settings." />
                    <Button Command="{Binding MapCommand}" Content="Map this game" Margin="0,2,8,2"
                            Visibility="{Binding ShowMap, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Map this game"
                            ToolTip="Launch the game twice, once changing nothing and once changing many graphics options, to find where its settings live." />
                </WrapPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Quiet}" Command="{Binding OpenIssueCommand}" Content="Open issue"
                        Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Open the request on GitHub" />
            </Grid>

            <!-- why the buttons are off -->
            <Grid Visibility="{Binding IsDisabled, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,2,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource DisabledAction}" Command="{Binding OpenSettingsCommand}" Content="Open the game lab in Settings"
                        Visibility="{Binding NeedsSetup, Converter={StaticResource VisibleWhen}}" />
            </Grid>

            <!-- passive hint: after a normal launch where the game changed most of the preset -->
            <TextBlock Text="{Binding HintText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0"
                       Visibility="{Binding HasHint, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Last launch note" />

            <!-- Test preset: confirm before launching -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding IsTestConfirming, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="{Binding TestTitle}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TestLead}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TestNote}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding StartTestCommand}" Margin="0,0,8,0" MinWidth="130"
                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Start test">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="{Binding StartTestText}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Test preset: running -->
            <TextBlock Text="Testing the preset. Play for about a minute without changing anything, then quit the game." Style="{StaticResource Text.Dim}"
                       TextWrapping="Wrap" Margin="2,10,0,0" Visibility="{Binding IsTesting, Converter={StaticResource VisibleWhen}}" />

            <!-- Test preset: result -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Test result" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        <Border CornerRadius="11" Padding="10,2,10,3" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding ResultHeadline}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultOverridden}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ResultHeadline}" FontSize="12.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultOverridden}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <ScrollViewer MaxHeight="{DynamicResource LabListMaxHeight}" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,8,0,0"
                                  Visibility="{Binding HasResultLines, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl ItemsSource="{Binding ResultLines}" Focusable="False" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}" Margin="0,1" Foreground="{DynamicResource TextDimBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding ResultMore}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                               Visibility="{Binding HasResultMore, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="Sent to the game lab." Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                               Visibility="{Binding ShowResultSent, Converter={StaticResource VisibleWhen}}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding SendResultCommand}" Margin="0,0,8,6"
                                Visibility="{Binding ShowSendResult, Converter={StaticResource VisibleWhen}}" input:FocusCue.FocusWhenShown="True"
                                AutomationProperties.Name="Send to game lab">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Send to game lab" /></StackPanel>
                        </Button>
                        <Button Command="{Binding SaveResultCommand}" Margin="0,0,8,6"
                                Visibility="{Binding ShowSaveResult, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Make a manual save"
                                ToolTip="Keep the settings the game left as a manual save.">
                            <TextBlock Text="Make a manual save" />
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding DismissResultCommand}" Margin="0,0,8,6"
                                input:FocusCue.FocusWhenShown="{Binding ShowSendResult, Converter={StaticResource Not}}"
                                AutomationProperties.Name="Close the test result">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="{Binding ResultCloseText}" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- confirmation with the evidence preview -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfirmLead}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="Looking at this PC…" Style="{StaticResource Text.Dim}" Margin="0,12,0,0"
                               Visibility="{Binding IsLoadingPreview, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasPreviewError, Converter={StaticResource VisibleWhen}}" />

                    <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                            <Run Text="What would be sent:" FontWeight="SemiBold" />
                            <Run Text="{Binding Preview.Summary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Paths only; no file contents are shown here. Personal details are removed before anything leaves this PC."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <ScrollViewer MaxHeight="{DynamicResource LabListMaxHeight}" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Preview.Items}" Focusable="False" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" Margin="0,1" Foreground="{DynamicResource TextDimBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding PrivacyNote}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" Content="{Binding SendText}" Margin="0,0,8,0" MinWidth="130"
                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Send request"
                                Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}" />
                        <Button Command="{Binding MapFirstCommand}" Margin="0,0,8,0" AutomationProperties.Name="Map this game first"
                                Visibility="{Binding ShowMapFirst, Converter={StaticResource VisibleWhen}}"
                                ToolTip="Two launches show Claude where this game really keeps its settings. You can still send the request without it.">
                            <TextBlock Text="Map this game first (recommended)" />
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Cancel">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
