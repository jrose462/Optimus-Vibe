<UserControl x:Class="OptimusVibe.App.Views.LabGamePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptimusVibe.App.Views"
             xmlns:svc="clr-namespace:OptimusVibe.App.Services"
             xmlns:input="clr-namespace:OptimusVibe.App.Input"
             HorizontalContentAlignment="Left">
    <!-- DataContext: LabGameViewModel. The guided checklist ("Step X of N"): done steps one line, the current step expanded with its buttons,
         upcoming steps one dim line. Manual tools (every other action, same buttons and captions as ever) sit at the bottom right. -->
    <UserControl.Resources>
        <!-- under the reason on the desktop, beside it when compact -->
        <Style x:Key="DisabledAction" TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Style.Triggers>
                <Trigger Property="svc:Density.IsCompact" Value="True">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Margin" Value="8,0,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- the current step's main button: filled, with the A glyph when a gamepad is connected -->
        <DataTemplate x:Key="StepPrimaryButton">
            <Button Style="{StaticResource Button.Primary}" Command="{Binding Command}" Margin="0,0,8,6" MinWidth="120"
                    AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" Visibility="{Binding ShowA, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Text}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- the quieter choices (a cancel carries the B glyph) -->
        <DataTemplate x:Key="StepQuietButton">
            <Button Style="{StaticResource Button.Quiet}" Command="{Binding Command}" Margin="0,0,8,6"
                    AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" Visibility="{Binding ShowB, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Text}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- one segment of the progress bar: done = filled, current = bright, upcoming = hollow -->
        <DataTemplate x:Key="StepSegment">
            <Border Height="6" CornerRadius="3" Margin="0,0,4,0" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- one row of the checklist -->
        <DataTemplate x:Key="StepRowTemplate">
            <Grid Margin="{DynamicResource LabRowMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- check (done), number on an accent ring (current), hollow circle (upcoming) -->
                <Border Width="{DynamicResource LabGlyphSize}" Height="{DynamicResource LabGlyphSize}" CornerRadius="13" BorderThickness="1.5"
                        VerticalAlignment="Top" Margin="0,0,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsDone, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Number}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsDone, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- done: one dim line -->
                <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Text.Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsDone, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding Summary}" />

                <!-- upcoming: one dim line -->
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFaintBrush}" Visibility="{Binding IsUpcoming, Converter={StaticResource VisibleWhen}}"
                           AutomationProperties.Name="{Binding Title}" />

                <!-- current: title, detail, buttons -->
                <StackPanel Grid.Column="1" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="{Binding Title}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.Name="{Binding Detail}" />

                    <Grid Margin="0,10,0,0" Visibility="{Binding HasButtons, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding Primary}" ContentTemplate="{StaticResource StepPrimaryButton}" Focusable="False" IsTabStop="False" VerticalAlignment="Top"
                                        Visibility="{Binding HasPrimary, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Secondary}" ItemTemplate="{StaticResource StepQuietButton}" Focusable="False" IsTabStop="False" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!-- the fix step: every setting the game changed (A opens the list, A again hides it), and the session card's snooze buttons -->
                    <WrapPanel Visibility="{Binding ShowFixExtras, Converter={StaticResource VisibleWhen}}">
                        <Button Style="{StaticResource Button.Quiet}" Margin="0,0,8,6"
                                Command="{Binding DataContext.ToggleChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="{Binding DataContext.ChangedWhichText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                AutomationProperties.Name="{Binding DataContext.ChangedWhichText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Every preset setting the game changed, with what it wrote and what it found afterwards." />
                        <Button Style="{StaticResource Button.Quiet}" Margin="0,0,8,6" Visibility="{Binding ShowSnooze, Converter={StaticResource VisibleWhen}}"
                                Command="{Binding DataContext.PostDismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                AutomationProperties.Name="{Binding DataContext.PostDismissText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DataContext.PostDismissText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Margin="0,0,8,6" Content="Don't ask again" Visibility="{Binding ShowSnooze, Converter={StaticResource VisibleWhen}}"
                                Command="{Binding DataContext.PostMuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                AutomationProperties.Name="Don't ask again for this game"
                                ToolTip="No more cards after sessions of this game on this device. Manual tools on this page turn them back on." />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding ShowFixExtras, Converter={StaticResource VisibleWhen}}">
                        <ScrollViewer MaxHeight="{DynamicResource LabListMaxHeight}" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="2,2,0,0"
                                      Visibility="{Binding DataContext.ShowChangedLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl ItemsSource="{Binding DataContext.ChangedLines, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" Margin="0,1" Foreground="{DynamicResource TextDimBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding DataContext.ChangedMore, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Text.Caption}" Margin="2,2,0,0"
                                   Visibility="{Binding DataContext.HasChangedMore, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Left on its own; stretched to its column when the game page puts it beside settings sync (HorizontalContentAlignment). -->
    <Border Style="{StaticResource Card}" MaxWidth="{DynamicResource LabMaxWidth}"
            HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <StackPanel>
            <!-- ============================================================ header: Game lab, request chip, Step X of N -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="Have Claude research this game's settings from evidence on this PC. It runs in your private config repo.">
                    <TextBlock Text="Game lab" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="10,2,10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding ChipLine}">
                        <TextBlock Text="{Binding ChipText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Quiet}" Command="{Binding OpenIssueCommand}" Content="Open issue" Margin="0,0,12,0"
                            Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Open the request on GitHub" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center" AutomationProperties.Name="{Binding ProgressText}" />
                </StackPanel>
            </Grid>

            <!-- ============================================================ progress: one segment per step -->
            <ItemsControl ItemsSource="{Binding StepRows}" ItemTemplate="{StaticResource StepSegment}" Focusable="False" IsTabStop="False" Margin="0,8,-4,0"
                          Visibility="{Binding ShowProgress, Converter={StaticResource VisibleWhen}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ============================================================ the checklist -->
            <ItemsControl x:Name="StepsHost" ItemsSource="{Binding StepRows}" ItemTemplate="{StaticResource StepRowTemplate}" Focusable="False" IsTabStop="False"
                          Visibility="{Binding ShowSteps, Converter={StaticResource VisibleWhen}}" />

            <!-- ============================================================ all set / set in-game: one headline, one dim line, at most one button -->
            <Grid Margin="{DynamicResource LabRowMargin}" Visibility="{Binding ShowSummary, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="{DynamicResource LabGlyphSize}" Height="{DynamicResource LabGlyphSize}" CornerRadius="13" Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Top" Margin="0,0,12,0" Visibility="{Binding IsAllSet, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SummaryHeadline}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding SummaryHeadline}" />
                    <TextBlock Text="{Binding SummaryDetail}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasSummaryDetail, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding SummaryDetail}" />
                    <ContentControl Content="{Binding SummaryButton}" ContentTemplate="{StaticResource StepPrimaryButton}" Focusable="False" IsTabStop="False"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding HasSummaryButton, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding VerifyNextLine}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="2,8,0,0"
                       Visibility="{Binding ShowVerifyNextLine, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding VerifyNextLine}" />

            <!-- after a session: only the questions the checklist can't answer stay a card (the consent question, "asked the lab"); inline, once, no
                 popup. It takes focus only when the player just came back from the game to this page (code-behind). -->
            <Border x:Name="PostCard" Style="{StaticResource Card.Inset}" Margin="0,10,0,0" KeyboardNavigation.DirectionalNavigation="Contained"
                    Visibility="{Binding HasPostSession, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="After your last session">
                <StackPanel>
                    <TextBlock Text="{Binding PostSessionText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PostSessionWhy}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasPostSessionWhy, Converter={StaticResource VisibleWhen}}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding PostPrimaryCommand}" Margin="0,0,8,6"
                                Visibility="{Binding ShowPostPrimary, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding PostPrimaryText}">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="{Binding PostPrimaryText}" /></StackPanel>
                        </Button>
                        <Button Command="{Binding PostSecondaryCommand}" Content="{Binding PostSecondaryText}" Margin="0,0,8,6"
                                Visibility="{Binding ShowPostSecondary, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding PostSecondaryText}" />
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding PostDismissCommand}" Margin="0,0,8,6" AutomationProperties.Name="{Binding PostDismissText}">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="{Binding PostDismissText}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding PostMuteCommand}" Content="Don't ask again" Margin="0,0,8,6"
                                Visibility="{Binding ShowPostMute, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Don't ask again for this game"
                                ToolTip="No more cards after sessions of this game on this device. Manual tools on this page turn them back on." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- why the buttons are off -->
            <Grid Visibility="{Binding IsDisabled, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,2,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource DisabledAction}" Command="{Binding OpenSettingsCommand}" Content="Open the game lab in Settings"
                        Visibility="{Binding NeedsSetup, Converter={StaticResource VisibleWhen}}" />
            </Grid>

            <!-- how the active preset reaches the game, and whether it was verified on this device (a flagged game's status line says it) -->
            <TextBlock Text="{Binding ApplyStatusText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0"
                       Visibility="{Binding HasApplyStatus, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="How the preset is applied" />

            <!-- Flag as set in-game: confirm -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding IsFlagConfirming, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="{Binding FlagTitle}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FlagLead}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding FlagWhy}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmFlagCommand}" Margin="0,0,8,0" MinWidth="130"
                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Flag as set in-game">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="{Binding FlagConfirmText}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- this device's kept copy of a cloud-synced settings file (autoSnapshot) -->
            <StackPanel Visibility="{Binding HasAutoSnapshot, Converter={StaticResource VisibleWhen}}" KeyboardNavigation.DirectionalNavigation="Contained">
                <TextBlock Text="{Binding AutoSnapshotLine}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0"
                           AutomationProperties.Name="Settings file kept on this device" />
                <Button Style="{StaticResource Button.Quiet}" Command="{Binding ForgetAutoCommand}" Content="Forget this device's copy" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Visibility="{Binding ShowForgetAuto, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Forget this device's copy"
                        ToolTip="Delete the settings file Optimus-Vibe kept for this preset. The next launch starts from whatever the game has." />
                <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Visibility="{Binding IsForgetConfirming, Converter={StaticResource VisibleWhen}}"
                        KeyboardNavigation.DirectionalNavigation="Contained">
                    <StackPanel>
                        <TextBlock Text="Forget this device's copy?" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                        <TextBlock Text="Optimus-Vibe will stop restoring it. You can set the game up again in-game and it is kept after you play." Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmForgetCommand}" Margin="0,0,8,0" MinWidth="130"
                                    input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Forget copy">
                                <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Forget it" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel">
                                <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Test preset: confirm before launching -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding IsTestConfirming, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="{Binding TestTitle}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TestLead}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TestNote}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding StartTestCommand}" Margin="0,0,8,0" MinWidth="130"
                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Start test">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="{Binding StartTestText}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Test preset: running -->
            <TextBlock Text="Testing the preset. Play for about a minute without changing anything, then quit the game." Style="{StaticResource Text.Dim}"
                       TextWrapping="Wrap" Margin="2,10,0,0" Visibility="{Binding IsTesting, Converter={StaticResource VisibleWhen}}" />

            <!-- Test preset: result -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Test result" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        <Border CornerRadius="11" Padding="10,2,10,3" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding ResultHeadline}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultOverridden}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ResultHeadline}" FontSize="12.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultOverridden}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <ScrollViewer MaxHeight="{DynamicResource LabListMaxHeight}" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,8,0,0"
                                  Visibility="{Binding HasResultLines, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl ItemsSource="{Binding ResultLines}" Focusable="False" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}" Margin="0,1" Foreground="{DynamicResource TextDimBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding ResultMore}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                               Visibility="{Binding HasResultMore, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="Sent to the game lab." Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                               Visibility="{Binding ShowResultSent, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding SuggestLine}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding ShowResultSuggest, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Why this game may be set in-game" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding SendResultCommand}" Margin="0,0,8,6"
                                Visibility="{Binding ShowSendResult, Converter={StaticResource VisibleWhen}}" input:FocusCue.FocusWhenShown="True"
                                AutomationProperties.Name="Send to game lab">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Send to game lab" /></StackPanel>
                        </Button>
                        <Button Command="{Binding SaveResultCommand}" Margin="0,0,8,6"
                                Visibility="{Binding ShowSaveResult, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Make a manual save"
                                ToolTip="Keep the settings the game left as a manual save.">
                            <TextBlock Text="Make a manual save" />
                        </Button>
                        <Button Command="{Binding FlagCommand}" Margin="0,0,8,6" Content="Flag as set in-game"
                                Visibility="{Binding ShowResultSuggest, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Flag as set in-game"
                                ToolTip="Stop writing this game's settings. The display and graphics-driver settings still apply." />
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding DismissResultCommand}" Margin="0,0,8,6"
                                input:FocusCue.FocusWhenShown="{Binding ShowSendResult, Converter={StaticResource Not}}"
                                AutomationProperties.Name="Close the test result">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="{Binding ResultCloseText}" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- confirmation with the evidence preview -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfirmLead}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="Looking at this PC…" Style="{StaticResource Text.Dim}" Margin="0,12,0,0"
                               Visibility="{Binding IsLoadingPreview, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasPreviewError, Converter={StaticResource VisibleWhen}}" />

                    <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                            <Run Text="What would be sent:" FontWeight="SemiBold" />
                            <Run Text="{Binding Preview.Summary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Paths only; no file contents are shown here. Personal details are removed before anything leaves this PC."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <ScrollViewer MaxHeight="{DynamicResource LabListMaxHeight}" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Preview.Items}" Focusable="False" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" Margin="0,1" Foreground="{DynamicResource TextDimBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding PrivacyNote}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" Content="{Binding SendText}" Margin="0,0,8,0" MinWidth="130"
                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Send request"
                                Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}" />
                        <Button Command="{Binding MapFirstCommand}" Margin="0,0,8,0" AutomationProperties.Name="Map this game first"
                                Visibility="{Binding ShowMapFirst, Converter={StaticResource VisibleWhen}}"
                                ToolTip="{Binding MapFirstTip}">
                            <TextBlock Text="Map this game first (recommended)" />
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Cancel">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ Manual tools: every other action, each once, with when/why. A expands in place, B collapses (focus back on the button). -->
            <Button x:Name="ToolsButton" Style="{StaticResource Button.Quiet}" Command="{Binding ToggleToolsCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Visibility="{Binding HasTools, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Manual tools">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ToolsText}" />
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE70D;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToolsOpen}" Value="True">
                                        <Setter Property="Text" Value="&#xE70E;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            <StackPanel x:Name="ToolsPanel" Margin="0,4,0,0" KeyboardNavigation.DirectionalNavigation="Contained"
                        Visibility="{Binding IsToolsOpen, Converter={StaticResource VisibleWhen}}">
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowRequestInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding RequestCommand}" Content="{Binding RequestText}" HorizontalAlignment="Left" AutomationProperties.Name="Request presets" />
                    <TextBlock Text="{Binding RequestCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowRefreshInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding RefreshPresetsCommand}" Content="Refresh presets" HorizontalAlignment="Left" AutomationProperties.Name="Refresh presets" />
                    <TextBlock Text="{Binding RefreshCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowSyncCheckInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding SyncCheckCommand}" Content="Re-check settings sync" HorizontalAlignment="Left" AutomationProperties.Name="Re-check settings sync" />
                    <TextBlock Text="{Binding SyncCheckCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowTestInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding TestCommand}" Content="Test preset" HorizontalAlignment="Left" AutomationProperties.Name="Test preset"
                            ToolTip="Launch the game once with nothing changed and see whether it keeps the preset's settings." />
                    <TextBlock Text="{Binding TestCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowVerifyNextInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding VerifyNextCommand}" Content="{Binding VerifyNextText}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding VerifyNextText}" />
                    <TextBlock Text="{Binding VerifyNextCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowMapInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding MapCommand}" Content="Map this game" HorizontalAlignment="Left" AutomationProperties.Name="Map this game"
                            ToolTip="Launch the game twice, once changing nothing and once changing many graphics options, to find where its settings live." />
                    <TextBlock Text="{Binding MapCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowManageAgainInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding ManageAgainCommand}" Content="Manage settings again" HorizontalAlignment="Left" AutomationProperties.Name="Manage settings again"
                            ToolTip="Optimus-Vibe writes this game&apos;s settings again and checks them by itself after you play (or test the preset now)." />
                    <TextBlock Text="{Binding ManageAgainCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowFlagInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding FlagCommand}" Content="Flag as set in-game" HorizontalAlignment="Left" AutomationProperties.Name="Flag as set in-game"
                            ToolTip="{Binding SuggestLine}" />
                    <TextBlock Text="{Binding FlagCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowUnmuteInTools, Converter={StaticResource VisibleWhen}}">
                    <Button Command="{Binding UnmuteCommand}" Content="Show cards after sessions again" HorizontalAlignment="Left"
                            AutomationProperties.Name="Show cards after sessions again" />
                    <TextBlock Text="{Binding UnmuteCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
