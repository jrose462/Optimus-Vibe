<UserControl x:Class="OptimusVibe.App.Views.LabGamePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:OptimusVibe.App.Input">
    <!-- DataContext: LabGameViewModel. Request / refresh presets, re-check settings sync, the evidence preview, the request's status. -->
    <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="760">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Game lab" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="10,2,10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding ChipLine}">
                        <TextBlock Text="{Binding ChipText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Quiet}" Command="{Binding OpenIssueCommand}" Content="Open issue"
                        Visibility="{Binding HasChip, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Open the request on GitHub" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Have Claude research this game's settings from evidence on this PC. It runs in your private config repo." />

            <WrapPanel Margin="0,14,0,0">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RequestCommand}" Content="{Binding RequestText}" Margin="0,0,8,6"
                        Visibility="{Binding ShowRequest, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Request presets" />
                <Button Command="{Binding RefreshPresetsCommand}" Content="Refresh presets" Margin="0,0,8,6"
                        Visibility="{Binding ShowRefresh, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Refresh presets" />
                <Button Command="{Binding SyncCheckCommand}" Content="Re-check settings sync" Margin="0,0,8,6"
                        Visibility="{Binding ShowSyncCheck, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Re-check settings sync" />
            </WrapPanel>

            <!-- why the buttons are off -->
            <StackPanel Visibility="{Binding IsDisabled, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,2,0,0" />
                <Button Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Command="{Binding OpenSettingsCommand}" Content="Open the game lab in Settings"
                        Visibility="{Binding NeedsSetup, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>

            <!-- confirmation with the evidence preview -->
            <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfirmLead}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="Looking at this PC…" Style="{StaticResource Text.Dim}" Margin="0,12,0,0"
                               Visibility="{Binding IsLoadingPreview, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasPreviewError, Converter={StaticResource VisibleWhen}}" />

                    <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                            <Run Text="What would be sent:" FontWeight="SemiBold" />
                            <Run Text="{Binding Preview.Summary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Paths only; no file contents are shown here. Personal details are removed before anything leaves this PC."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Preview.Items}" Focusable="False" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" Margin="0,1" Foreground="{DynamicResource TextDimBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding PrivacyNote}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" Content="{Binding SendText}" Margin="0,0,8,0" MinWidth="130"
                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Send request"
                                Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}" />
                        <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" input:FocusCue.FocusWhenShown="True" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
