<Window x:Class="OptimusVibe.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OptimusVibe.App.Views"
        xmlns:vm="clr-namespace:OptimusVibe.App.ViewModels"
        xmlns:input="clr-namespace:OptimusVibe.App.Input"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Optimus-Vibe"
        Icon="/Assets/app.ico"
        Width="1360" Height="880" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource WindowFontSize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- App-styled title bar: the header row is the caption (CaptionHeight is set from its height in MainWindow.xaml.cs).
         WindowStyle stays SingleBorderWindow so Aero Snap, Win+arrows and the system menu keep working. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="SystemCommands.MinimizeWindowCommand" Executed="OnMinimize" />
        <CommandBinding Command="SystemCommands.MaximizeWindowCommand" Executed="OnMaximize" />
        <CommandBinding Command="SystemCommands.RestoreWindowCommand" Executed="OnRestore" />
        <CommandBinding Command="SystemCommands.CloseWindowCommand" Executed="OnClose" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <!-- page: navy to teal with a soft warm glow at the lower left -->
        <Border Background="{DynamicResource PageBrush}" />
        <Border Background="{DynamicResource PageGlowBrush}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource PagePatternBrush}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <!-- HeaderBar is the whole caption area (its ActualHeight drives WindowChrome.CaptionHeight). Caption buttons sit flush top-right. -->
            <Grid x:Name="HeaderBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Margin="{DynamicResource HeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- logo + name; part of the draggable caption (not hit-testable in chrome) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app-64.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Optimus-Vibe logo" />
                    <TextBlock Text="Optimus-Vibe" FontFamily="{StaticResource DisplayFont}" FontSize="{DynamicResource HeaderTitleSize}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- non-interactive badge: a 4K TV / 4K stream is in use, so Big Picture presets apply; the tooltip says why -->
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Big Picture TV active" ToolTip="{Binding TvTooltip}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsTvActive, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="TV" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="{DynamicResource CaptionSize}"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- non-modal: a newer release exists (silent daily check) -->
                    <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Update available" Command="{Binding Updates.ShowCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="A new version is ready. Open Settings to get it."
                            Visibility="{Binding Updates.IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" />
                            <Border Style="{StaticResource Dot.Attention}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" />
                        </Grid>
                    </Button>
                    <!-- non-modal indicator: reports / lab requests saved while offline, waiting to be sent -->
                    <Button Style="{StaticResource Button.Quiet}" AutomationProperties.Name="Waiting to send" Command="{Binding Outbox.OpenCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,6,0"
                            ToolTip="Waiting to send (offline). Click to see them."
                            Visibility="{Binding Outbox.HasItems, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Outbox.BadgeText}" Margin="6,0,0,0" FontSize="{DynamicResource CaptionSize}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <views:ButtonGlyph Kind="Y" Size="Small" Margin="6,0,0,0" />
                    <Button Style="{StaticResource Button.Quiet}" AutomationProperties.Name="Sync saves" Command="{Binding SyncCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Sync your saves and library with the config repo (Y)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Sync saves" Margin="6,0,0,0" FontSize="{DynamicResource CaptionSize}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Report a problem" Command="{Binding OpenReportCommand}"
                            ToolTip="Report a problem" Margin="6,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- caption buttons (not focusable: controller / Tab navigation skips them) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Command="SystemCommands.MinimizeWindowCommand"
                        AutomationProperties.Name="Minimize" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="MaxRestoreButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Command="SystemCommands.MaximizeWindowCommand"
                        AutomationProperties.Name="Maximize" ToolTip="Maximize" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;" Command="SystemCommands.CloseWindowCommand"
                        AutomationProperties.Name="Close" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />

            <!-- ============================================================ steam banner (non-modal) -->
            <StackPanel Grid.Row="2">
            <!-- GitHub refused the saved sign-in (issue #85): sync and the game lab are paused until the user signs in again -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource BannerMargin}" Padding="{DynamicResource BannerPadding}" CornerRadius="{DynamicResource BannerRadius}"
                    Visibility="{Binding HasSignInBanner, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Dot.Attention}" Margin="0,0,14,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="GitHub sign-in stopped working" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="GitHub no longer accepts this device's sign-in, so sync and the game lab are paused. Sign in again to resume." />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding SignInHealthText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SignInAgainButton" Style="{StaticResource Button.Primary}" Command="{Binding SignInAgainCommand}"
                                input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Sign in again">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="A" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Sign in again" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Quiet}" Command="{Binding DismissSignInCommand}" Margin="6,0,0,0"
                                ToolTip="Hide this until the app restarts" AutomationProperties.Name="Later">
                            <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Later" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="{DynamicResource BannerMargin}" Padding="{DynamicResource BannerPadding}" CornerRadius="{DynamicResource BannerRadius}"
                    Visibility="{Binding HasSteamBanner, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Dot.Attention}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Margin="0,0,16,0"
                               Text="{Binding SteamBannerText}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ApplySteamButton" Style="{StaticResource Button.Primary}" Command="{Binding ApplySteamCommand}"
                                Content="Close Steam and apply" AutomationProperties.Name="Close Steam and apply" />
                        <Button x:Name="ReviewSteamButton" Content="Review…" Command="{Binding ReviewSteamCommand}" Margin="6,0,0,0"
                                ToolTip="Choose which games get their Steam launch option updated" AutomationProperties.Name="Review Steam launch options" />
                        <Button Content="Later" Style="{StaticResource Button.Quiet}" Command="{Binding DismissSteamCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <!-- ============================================================ content -->
            <Grid Grid.Row="3">
                <Grid IsEnabled="{Binding IsModalOpen, Converter={StaticResource Not}}">
                    <!-- loading -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Getting your games ready…" Style="{StaticResource Text.H3}" Margin="0,14,0,0" />
                    </StackPanel>

                    <!-- first run / setup -->
                    <views:SetupView Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}" />

                    <!-- library -->
                    <views:LibraryView x:Name="LibraryPage" DataContext="{Binding Library}"
                                       Visibility="{Binding DataContext.IsLibraryPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                    <!-- one library game -->
                    <views:LibraryDetailView x:Name="LibraryDetail"
                                             Visibility="{Binding IsDetailPage, Converter={StaticResource VisibleWhen}}" />

                    <!-- settings -->
                    <views:SettingsView x:Name="SettingsPage" DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                    <!-- manage (list + detail) -->
                    <Grid Visibility="{Binding IsManagePage, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="{DynamicResource ManageListMargin}" Padding="{DynamicResource ManageListPadding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.H2}" Margin="{DynamicResource ManageListTitleMargin}">
                                    <Run Text="Your games" />
                                    <Run Text="{Binding Games.Count, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" FontWeight="Normal" />
                                </TextBlock>
                                <ListBox x:Name="GameList" Style="{StaticResource GameList}" ItemContainerStyle="{StaticResource GameListItem}"
                                         ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource Dot.Attention}" Margin="10,0,0,0"
                                                        Visibility="{Binding NeedsAttention, Converter={StaticResource VisibleWhen}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <views:GameDetailView x:Name="Detail" Grid.Column="1" DataContext="{Binding SelectedDetail}"
                                              Visibility="{Binding DataContext.SelectedDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- no games -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="620" Padding="32"
                                Visibility="{Binding Games.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="No games yet" Style="{StaticResource Text.H2}" />
                                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                                           Text="Ask Claude to add one with the game-settings skill, then sync and refresh here." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- starting a game -->
                <Grid DataContext="{Binding Launching}"
                      Visibility="{Binding DataContext.IsLaunching, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                    <Border Background="{DynamicResource LaunchBackdropBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="200" Height="300">
                            <Border CornerRadius="24" Background="{DynamicResource CoverTileBrush}">
                                <Image Source="{Binding Icon}" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="24" Visibility="{Binding HasArt, Converter={StaticResource VisibleWhen}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" Margin="0,26,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold">
                            <Run Text="Starting" />
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="…" />
                        </TextBlock>
                        <TextBlock Text="{Binding PlayHint}" Style="{StaticResource Text.Lead}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <ProgressBar Style="{StaticResource BusyBar}" Width="260" Margin="0,22,0,0" />
                    </StackPanel>
                </Grid>

                <!-- report a problem (modal panel; B / Esc closes) -->
                <Grid DataContext="{Binding Report}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                      Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}">
                    <Border Background="{DynamicResource BackdropBrush}" />
                    <Border Style="{StaticResource Overlay.Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Report a problem" Style="{StaticResource Text.OverlayTitle}" />
                                <TextBlock Style="{StaticResource Text.Lead}" Margin="0,6,0,0"
                                           Text="Tell us what went wrong. You can preview exactly what gets sent before it is filed as a public issue. No GitHub sign-in needed." />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="{Binding ContextText}" />
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Dim}" Margin="0,14,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Text="This report will be public on GitHub. Review the preview - personal details are removed automatically." />

                            <!-- how it is sent -->
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Dim}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Text="{Binding SendInfoText}" />

                            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Style="{StaticResource Button.Quiet}" Command="{Binding CloseCommand}" Margin="0,0,8,0" AutomationProperties.Name="Cancel">
                                    <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                                </Button>
                                <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,0" AutomationProperties.Name="Preview report" />
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding SendLabel}" Command="{Binding SendCommand}" MinWidth="120"
                                        AutomationProperties.Name="Send report" ToolTip="Available once you have previewed the current text" />
                            </WrapPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="What went wrong?" Style="{StaticResource Text.H3}" Margin="0,20,0,8" />
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="96" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Describe the problem" />

                                    <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Margin="0,18,0,8" Style="{StaticResource Text.H3}" Text="What will be sent" />
                                        <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                        <TextBlock Text="You changed the description. Preview again before sending."
                                                   Style="{StaticResource Text.Dim}" Margin="0,0,0,8"
                                                   Visibility="{Binding PreviewIsStale, Converter={StaticResource VisibleWhen}}" />
                                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260"
                                                 VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                 AutomationProperties.Name="Report preview" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- waiting to send (offline outbox; modal panel; B / Esc closes) -->
                <Grid DataContext="{Binding Outbox}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                      Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}">
                    <Border Background="{DynamicResource BackdropBrush}" />
                    <Border Style="{StaticResource Overlay.Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Waiting to send" Style="{StaticResource Text.OverlayTitle}" />
                                <TextBlock Style="{StaticResource Text.Lead}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="These were saved while you were offline. They are sent by themselves when you are back online." />
                            </StackPanel>

                            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Style="{StaticResource Button.Quiet}" Command="{Binding CloseCommand}" Margin="0,0,8,0" AutomationProperties.Name="Close">
                                    <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Close" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Primary}" Content="Send now" Command="{Binding SendNowCommand}" MinWidth="120"
                                        input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Send now" ToolTip="Try to send everything that is waiting" />
                            </WrapPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="{DynamicResource OverlayListMaxHeight}" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,12,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:OutboxItemViewModel}">
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel MaxWidth="640" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Text.Caption}">
                                                        <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding WhenText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                                                               Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource Button.Quiet}" Content="{Binding DiscardLabel}" Command="{Binding DiscardCommand}"
                                                        VerticalAlignment="Center" AutomationProperties.Name="Discard" ToolTip="Remove it without sending (click twice)" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- review Steam launch options (modal panel; B / Esc closes) -->
                <Grid DataContext="{Binding SteamReview}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                      Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}">
                    <Border Background="{DynamicResource BackdropBrush}" />
                    <Border Style="{StaticResource Overlay.Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Steam launch options" Style="{StaticResource Text.OverlayTitle}" />
                                <TextBlock Style="{StaticResource Text.Lead}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Pick the games whose Steam launch option should be updated. Optimus-Vibe closes Steam, makes the change, checks it and puts Steam back the way it was (back in the tray if it was only running in the background)." />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Games whose settings sync between devices, or might, start ticked; games confirmed (medium or high confidence) to keep their settings on this device start unticked. Unticked games keep their current Steam launch option; change this per game on its page." />
                            </StackPanel>

                            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Select all" Style="{StaticResource Button.Quiet}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                                <Button Content="Select none" Style="{StaticResource Button.Quiet}" Command="{Binding SelectNoneCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelCommand}" Margin="0,0,8,0" AutomationProperties.Name="Cancel">
                                    <StackPanel Orientation="Horizontal"><views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" /><TextBlock Text="Cancel" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" MinWidth="170"
                                        AutomationProperties.Name="Apply selected" />
                            </WrapPanel>

                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" Margin="6,12,0,0" Text="{Binding SummaryText}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="{DynamicResource OverlayListMaxHeight}" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,12,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SteamReviewItem}">
                                            <CheckBox IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding Name}"
                                                      input:FocusCue.FocusWhenShown="{Binding IsFirst, Mode=OneTime}">
                                                <StackPanel MaxWidth="700" Margin="0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding BeforeText, Mode=OneWay}" /><Run Text="  →  " /><Run Text="{Binding AfterText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SyncText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- toast -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,12" MaxWidth="640"
                        Background="{DynamicResource ToastBrush}" CornerRadius="26"
                        Visibility="{Binding HasToast, Converter={StaticResource VisibleWhen}}">
                    <Grid Margin="24,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Dot}" Margin="0,0,12,0" Background="{DynamicResource DangerBrush}"
                                Visibility="{Binding ToastIsError, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Grid.Column="1" Text="{Binding ToastText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{Binding ToastActionText}" Command="{Binding ToastActionCommand}" Margin="14,0,0,0"
                                Style="{StaticResource Button.Primary}" MinHeight="38" Padding="18,4"
                                Visibility="{Binding HasToastAction, Converter={StaticResource VisibleWhen}}" />
                        <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Focusable="False" Margin="6,0,0,0" Width="38" Height="38"
                                Command="{Binding DismissToastCommand}" ToolTip="Dismiss">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ floating navigation + action button -->
            <Grid Grid.Row="5" Margin="{DynamicResource NavRowMargin}" Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Background="{DynamicResource NavBrush}" CornerRadius="{DynamicResource NavRadius}" Padding="{DynamicResource NavPadding}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavLibrary}" Command="{Binding ShowLibraryCommand}"
                                AutomationProperties.Name="Library" ToolTip="Your games as covers">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource NavGlyphSize}" HorizontalAlignment="Center" />
                                <TextBlock Text="Library" Margin="{DynamicResource NavLabelMargin}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavManage}" Command="{Binding ShowManageCommand}"
                                AutomationProperties.Name="Presets" ToolTip="Games and their presets side by side">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource NavGlyphSize}" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Presets" Margin="{DynamicResource NavLabelMargin}" />
                                    <!-- on the Library page the controller's X opens a game's presets -->
                                    <views:ButtonGlyph Kind="X" Size="Small" Margin="4,0,0,0" VerticalAlignment="Bottom"
                                                       Visibility="{Binding IsLibraryPage, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavSaves}" Command="{Binding ShowSavesCommand}"
                                AutomationProperties.Name="Saves" ToolTip="Your own saved settings">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource NavGlyphSize}" HorizontalAlignment="Center" />
                                <TextBlock Text="Saves" Margin="{DynamicResource NavLabelMargin}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavSettings}" Command="{Binding OpenSettingsCommand}"
                                AutomationProperties.Name="Settings" ToolTip="Sync, launchers and device (Ctrl+,)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource NavGlyphSize}" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Settings" Margin="{DynamicResource NavLabelMargin}" />
                                    <views:ButtonGlyph Kind="Menu" Size="Small" Margin="4,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- one round action per page, with the controller button that does the same -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <views:ButtonGlyph Kind="View" Margin="0,0,8,0" Visibility="{Binding IsLibraryPage, Converter={StaticResource VisibleWhen}}" />
                    <views:ButtonGlyph Kind="X" Margin="0,0,8,0" Visibility="{Binding IsDetailPage, Converter={StaticResource VisibleWhen}}" />
                    <views:ButtonGlyph Kind="X" Margin="0,0,8,0" Visibility="{Binding IsManagePage, Converter={StaticResource VisibleWhen}}" />
                    <Grid>
                        <Button Style="{StaticResource Button.Fab.Primary}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Reload"
                                ToolTip="Reload settings and look for games again (View)"
                                Visibility="{Binding IsLibraryPage, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="&#xE72C;" />
                        </Button>
                        <Button Style="{StaticResource Button.Fab.Primary}" Command="{Binding DetailTile.PlayCommand}" AutomationProperties.Name="Play"
                                ToolTip="{Binding DetailTile.PlayHint}"
                                Visibility="{Binding IsDetailPage, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="&#xE768;" />
                        </Button>
                        <Button Style="{StaticResource Button.Fab.Primary}" Command="{Binding LaunchCommand}" AutomationProperties.Name="Launch game"
                                ToolTip="Launch with the active preset"
                                Visibility="{Binding IsManagePage, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="&#xE768;" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
