<Window x:Class="OptimusVibe.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OptimusVibe.App.Views"
        xmlns:vm="clr-namespace:OptimusVibe.App.ViewModels"
        xmlns:input="clr-namespace:OptimusVibe.App.Input"
        Title="Optimus-Vibe"
        Width="1360" Height="880" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0E2436"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- page: navy to teal with a soft warm glow at the lower left -->
        <Border Background="{StaticResource PageBrush}" />
        <Border Background="{StaticResource PageGlowBrush}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Margin="32,14,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Optimus-Vibe" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- non-modal: a newer release exists (silent daily check) -->
                    <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Update available" Command="{Binding Updates.ShowCommand}"
                            ToolTip="A new version is ready. Open Settings to get it."
                            Visibility="{Binding Updates.IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" />
                            <Border Style="{StaticResource Dot.Attention}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Sync" Command="{Binding SyncCommand}"
                            ToolTip="Sync your saves and library with the config repo">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}"
                            ToolTip="Reload everything and look for games again">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" AutomationProperties.Name="Report a problem" Command="{Binding OpenReportCommand}"
                            ToolTip="Report a problem"
                            Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" />
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />

            <!-- ============================================================ steam banner (non-modal) -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="32,8,32,4" Padding="24,14" CornerRadius="26"
                    Visibility="{Binding HasSteamBanner, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Dot.Attention}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Margin="0,0,16,0"
                               Text="{Binding SteamBannerText}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ApplySteamButton" Style="{StaticResource Button.Primary}" Command="{Binding ApplySteamCommand}"
                                Content="Close Steam and apply" AutomationProperties.Name="Close Steam and apply" />
                        <Button Content="Later" Style="{StaticResource Button.Quiet}" Command="{Binding DismissSteamCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ content -->
            <Grid Grid.Row="3">
                <Grid IsEnabled="{Binding Report.IsOpen, Converter={StaticResource Not}}">
                    <!-- loading -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Getting your games ready…" Style="{StaticResource Text.H3}" Margin="0,14,0,0" />
                    </StackPanel>

                    <!-- first run / setup -->
                    <views:SetupView Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}" />

                    <!-- library -->
                    <views:LibraryView x:Name="LibraryPage" DataContext="{Binding Library}"
                                       Visibility="{Binding DataContext.IsLibraryPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                    <!-- one library game -->
                    <views:LibraryDetailView x:Name="LibraryDetail"
                                             Visibility="{Binding IsDetailPage, Converter={StaticResource VisibleWhen}}" />

                    <!-- settings -->
                    <views:SettingsView x:Name="SettingsPage" DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                    <!-- manage (list + detail) -->
                    <Grid Visibility="{Binding IsManagePage, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="32,12,0,8" Padding="14,22,14,14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.H2}" Margin="12,0,0,12">
                                    <Run Text="Your games" />
                                    <Run Text="{Binding Games.Count, Mode=OneWay}" Foreground="{StaticResource TextFaintBrush}" FontWeight="Normal" />
                                </TextBlock>
                                <ListBox x:Name="GameList" Style="{StaticResource GameList}" ItemContainerStyle="{StaticResource GameListItem}"
                                         ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource Dot.Attention}" Margin="10,0,0,0"
                                                        Visibility="{Binding NeedsAttention, Converter={StaticResource VisibleWhen}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <views:GameDetailView x:Name="Detail" Grid.Column="1" DataContext="{Binding SelectedDetail}"
                                              Visibility="{Binding DataContext.SelectedDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- no games -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="620" Padding="32"
                                Visibility="{Binding Games.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="No games yet" Style="{StaticResource Text.H2}" />
                                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                                           Text="Ask Claude to add one with the game-settings skill, then sync and refresh here." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- starting a game -->
                <Grid DataContext="{Binding Launching}"
                      Visibility="{Binding DataContext.IsLaunching, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                    <Border Background="#EB0A1624" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="200" Height="300">
                            <Border CornerRadius="24" Background="{StaticResource CoverTileBrush}">
                                <Image Source="{Binding Icon}" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="24" Visibility="{Binding HasArt, Converter={StaticResource VisibleWhen}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" Margin="0,26,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold">
                            <Run Text="Starting" />
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="…" />
                        </TextBlock>
                        <TextBlock Text="{Binding PlayHint}" Style="{StaticResource Text.Lead}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <ProgressBar Style="{StaticResource BusyBar}" Width="260" Margin="0,22,0,0" />
                    </StackPanel>
                </Grid>

                <!-- report a problem (modal panel; B / Esc closes) -->
                <Grid DataContext="{Binding Report}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                      Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}">
                    <Border Background="{StaticResource BackdropBrush}" />
                    <Border Style="{StaticResource Card}" MaxWidth="860" Margin="24" VerticalAlignment="Center" Padding="32,28">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Report a problem" Style="{StaticResource Text.PageTitle}" FontSize="28" />
                                <TextBlock Style="{StaticResource Text.Lead}" Margin="0,6,0,0"
                                           Text="Tell us what went wrong. You can preview exactly what gets sent before it is filed as an issue." />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="{Binding ContextText}" />
                            </StackPanel>

                            <!-- not signed in -->
                            <Border DockPanel.Dock="Top" Style="{StaticResource Card.Inset}" Margin="0,16,0,0"
                                    Visibility="{Binding IsSignedOut, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="Sending needs a GitHub sign-in. You can still write the report and preview it." />
                                    <Button Content="Go to GitHub sign-in" Command="{Binding GoToSignInCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CloseCommand}" Margin="0,0,8,0" />
                                <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,0" AutomationProperties.Name="Preview report" />
                                <Button Style="{StaticResource Button.Primary}" Content="Send" Command="{Binding SendCommand}" MinWidth="120"
                                        AutomationProperties.Name="Send report" ToolTip="Available once you have previewed the current text" />
                            </WrapPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="What went wrong?" Style="{StaticResource Text.H3}" Margin="0,20,0,8" />
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="96" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Describe the problem" />

                                    <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Margin="0,18,0,8" Style="{StaticResource Text.H3}" Text="What will be sent" />
                                        <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                        <TextBlock Text="You changed the description. Preview again before sending."
                                                   Style="{StaticResource Text.Dim}" Margin="0,0,0,8"
                                                   Visibility="{Binding PreviewIsStale, Converter={StaticResource VisibleWhen}}" />
                                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260"
                                                 VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                 AutomationProperties.Name="Report preview" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- toast -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,12" MaxWidth="640"
                        Background="#F5232429" CornerRadius="26"
                        Visibility="{Binding HasToast, Converter={StaticResource VisibleWhen}}">
                    <Grid Margin="24,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Dot}" Margin="0,0,12,0" Background="{StaticResource DangerBrush}"
                                Visibility="{Binding ToastIsError, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Grid.Column="1" Text="{Binding ToastText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{Binding ToastActionText}" Command="{Binding ToastActionCommand}" Margin="14,0,0,0"
                                Style="{StaticResource Button.Primary}" MinHeight="38" Padding="18,4"
                                Visibility="{Binding HasToastAction, Converter={StaticResource VisibleWhen}}" />
                        <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Focusable="False" Margin="6,0,0,0" Width="38" Height="38"
                                Command="{Binding DismissToastCommand}" ToolTip="Dismiss">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ quiet controller hints (only while a gamepad is connected) -->
            <TextBlock Grid.Row="4" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,2"
                       Text="{Binding ControllerHint}"
                       Visibility="{Binding IsGamepadConnected, Converter={StaticResource VisibleWhen}}" />

            <!-- ============================================================ floating navigation + action button -->
            <Grid Grid.Row="5" Margin="32,6,32,18" Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Background="{StaticResource NavBrush}" CornerRadius="38" Padding="8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavLibrary}" Command="{Binding ShowLibraryCommand}"
                                AutomationProperties.Name="Library" ToolTip="Your games as covers">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock Text="Library" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavManage}" Command="{Binding ShowManageCommand}"
                                AutomationProperties.Name="Presets" ToolTip="Games and their presets side by side">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock Text="Presets" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavSaves}" Command="{Binding ShowSavesCommand}"
                                AutomationProperties.Name="Saves" ToolTip="Your own saved settings">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock Text="Saves" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.NavItem}" Tag="{Binding NavSettings}" Command="{Binding OpenSettingsCommand}"
                                AutomationProperties.Name="Settings" ToolTip="Sync, launchers and device (Ctrl+,)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock Text="Settings" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- one round action per page -->
                <Grid Grid.Column="2" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Fab.Primary}" Command="{Binding Library.RescanCommand}" AutomationProperties.Name="Rescan games"
                            ToolTip="Look for installed games again"
                            Visibility="{Binding IsLibraryPage, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE72C;" />
                    </Button>
                    <Button Style="{StaticResource Button.Fab.Primary}" Command="{Binding DetailTile.PlayCommand}" AutomationProperties.Name="Play"
                            ToolTip="{Binding DetailTile.PlayHint}"
                            Visibility="{Binding IsDetailPage, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE768;" />
                    </Button>
                    <Button Style="{StaticResource Button.Fab.Primary}" Command="{Binding LaunchCommand}" AutomationProperties.Name="Launch game"
                            ToolTip="Launch with the active preset"
                            Visibility="{Binding IsManagePage, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE768;" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
