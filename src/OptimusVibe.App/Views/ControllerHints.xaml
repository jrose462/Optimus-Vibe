<UserControl x:Class="OptimusVibe.App.Views.ControllerHints"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptimusVibe.App.Views"
             xmlns:vm="clr-namespace:OptimusVibe.App.ViewModels"
             Focusable="False" IsTabStop="False">
    <!-- DataContext: MainViewModel. The quiet "A play  X presets  LB RB filter" line; shown only while a gamepad is connected. -->
    <ItemsControl ItemsSource="{Binding ControllerHints}" Focusable="False" IsTabStop="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PadHint}">
                <StackPanel Orientation="Horizontal" Margin="9,0">
                    <views:ButtonGlyph Size="Small" Kind="{Binding First}" Always="True" />
                    <views:ButtonGlyph Size="Small" Kind="{Binding Second, TargetNullValue=A, FallbackValue=A}" Always="True" Margin="3,0,0,0"
                                       Visibility="{Binding Second, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
