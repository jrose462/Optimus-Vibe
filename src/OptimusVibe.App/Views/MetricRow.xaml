<UserControl x:Class="OptimusVibe.App.Views.MetricRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" IsTabStop="False">
    <!-- A round coloured icon, a big bold number and a small unit: "3  tuned". Trims when the value is long. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource MetricIcon}" Background="{Binding IconBrush, ElementName=Self}">
            <TextBlock Text="{Binding Glyph, ElementName=Self}" FontFamily="{StaticResource IconFont}" FontSize="17"
                       Foreground="{StaticResource MetricGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Value, ElementName=Self, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}" />
            <Run Text="{Binding Unit, ElementName=Self, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
        </TextBlock>
    </Grid>
</UserControl>
