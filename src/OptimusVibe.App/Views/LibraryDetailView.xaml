<UserControl x:Class="OptimusVibe.App.Views.LibraryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptimusVibe.App.Views"
             xmlns:input="clr-namespace:OptimusVibe.App.Input">
    <!-- DataContext: MainViewModel. One library game: back + the manage toggle, then its presets (or why there are none). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- strip -->
        <Grid DataContext="{Binding DetailTile}" Margin="26,6,32,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource Button.Icon}" VerticalAlignment="Center" AutomationProperties.Name="Back to library"
                    ToolTip="Back to the library"
                    Command="{Binding DataContext.BackToLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="&#xE72B;" />
            </Button>

            <!-- manage toggle -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding CanToggleManaged, Converter={StaticResource VisibleWhen}}">
                <CheckBox x:Name="ManageToggle" Content="Manage this game's settings" FontWeight="SemiBold"
                          IsChecked="{Binding IsManaged, Mode=OneWay}"
                          Command="{Binding SetManagedCommand}"
                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                          ToolTip="Off: Optimus-Vibe never touches this game. It starts normally and its Steam launch option is removed. Synced to your other devices." />
                <CheckBox x:Name="SteamKeepToggle" Content="Keep Steam launch option up to date"
                          IsChecked="{Binding KeepSteamOptionUpToDate, Mode=OneWay}"
                          Command="{Binding SetSteamKeepCommand}"
                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                          Visibility="{Binding IsSteam, Converter={StaticResource VisibleWhen}}"
                          ToolTip="Off: Optimus-Vibe never changes this game's Steam launch option, whatever you choose in the update review. Synced to your other devices." />
                <Grid Margin="38,0,0,0"
                            Visibility="{Binding SuggestOptOut, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Dot.Attention}" Margin="0,5,8,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="This game keeps its graphics settings per machine, so you can safely opt out." />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- presets (configured games) -->
        <views:GameDetailView x:Name="GameDetail" Grid.Row="1" DataContext="{Binding SelectedDetail}"
                              Visibility="{Binding DataContext.DetailHasConfig, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />

        <!-- no config yet / opted out -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding DetailHasConfig, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <Grid DataContext="{Binding DetailTile}" Margin="32,8,32,12" MaxWidth="1000" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="220" Height="330" VerticalAlignment="Top">
                    <Border CornerRadius="24" Background="{DynamicResource CoverTileBrush}">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <Image Source="{Binding Icon}" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center"
                                   Visibility="{Binding HasIcon, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="44" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       Visibility="{Binding HasIcon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="24" Visibility="{Binding HasArt, Converter={StaticResource VisibleWhen}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="32,0,0,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.PageTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PlayHint}" Style="{StaticResource Text.Lead}" Margin="0,6,0,0" />
                    <Button x:Name="PlayButton" Style="{StaticResource Button.Large}" HorizontalAlignment="Left" Margin="0,22,0,0" MinWidth="180"
                            Command="{Binding PlayCommand}" AutomationProperties.Name="Play" input:FocusCue.FocusWhenShown="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>

                    <!-- queued for Claude: the one feature card -->
                    <Border Style="{StaticResource Card.Feature}" Margin="0,28,0,0"
                            Visibility="{Binding IsQueued, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Waiting for presets" Style="{StaticResource Text.H2}" Foreground="{DynamicResource FeatureTextBrush}" />
                            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource FeatureTextBrush}" Margin="0,8,0,0"
                                       Text="This game is in the queue. Ask Claude to “process Optimus-Vibe requests” and it will research the settings and write presets for your devices. Until then it starts normally." />
                        </StackPanel>
                    </Border>

                    <!-- opted out -->
                    <Border Style="{StaticResource Card}" Margin="0,28,0,0"
                            Visibility="{Binding IsManaged, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="Opted out" Style="{StaticResource Text.H2}" />
                            <TextBlock Style="{StaticResource Text.Dim}" Margin="0,8,0,0"
                                       Text="Optimus-Vibe leaves this game alone on every device. Turn on “Manage this game's settings” at the top to change that." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
