<Window x:Class="OptimusVibe.App.Views.MapGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OptimusVibe.App.Views"
        xmlns:svc="clr-namespace:OptimusVibe.App.Services"
        Title="Optimus-Vibe"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource WindowFontSize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- DataContext: MapGameModel. Full-screen like the post-game prompt so it sits above the Xbox full-screen shell / Big Picture.
         A = the main action, Y = keep my changes, B = back / close. Steps: launch 1 (change nothing), launch 2 (change many options), summary. -->
    <Grid>
        <Border Background="{DynamicResource PageBrush}" />
        <Border Background="{DynamicResource PageGlowBrush}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource PagePatternBrush}" IsHitTestVisible="False" />

        <Viewbox Stretch="Uniform" MaxWidth="1700" MaxHeight="950" VerticalAlignment="Center">
            <Viewbox.Style>
                <Style TargetType="Viewbox">
                    <Setter Property="StretchDirection" Value="Both" />
                    <Style.Triggers>
                        <Trigger Property="svc:Density.IsCompact" Value="True">
                            <Setter Property="StretchDirection" Value="DownOnly" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Viewbox.Style>
            <Border Style="{StaticResource Card}" Width="{DynamicResource PromptWidth}" Margin="{DynamicResource PromptMargin}" Padding="{DynamicResource PromptPadding}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Optimus-Vibe" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StepText}" Style="{StaticResource Text.Caption}" Margin="14,3,0,0" AutomationProperties.Name="Step" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Lead}" Style="{StaticResource Text.Lead}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PassAResult}" Style="{StaticResource Text.Body}" Margin="0,14,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                               Visibility="{Binding HasPassAResult, Converter={StaticResource VisibleWhen}}" />

                    <!-- what the two launches found -->
                    <Border Style="{StaticResource Card.Inset}" Margin="{DynamicResource BlockGap}" Padding="{DynamicResource PromptInsetPadding}"
                            Visibility="{Binding IsSummary, Converter={StaticResource VisibleWhen}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="{DynamicResource PromptListMaxHeight}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding HasSettingsLines, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding SettingsHeading}" Style="{StaticResource Text.H3}" />
                                    <ItemsControl ItemsSource="{Binding SettingsLines}" Focusable="False" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="{DynamicResource PromptLineSize}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="{Binding NoSettingsText}" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                                           Visibility="{Binding NoSettingsFound, Converter={StaticResource VisibleWhen}}" />
                                <StackPanel Visibility="{Binding HasStateLines, Converter={StaticResource VisibleWhen}}" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding StateHeading}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding StateLines}" Focusable="False" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="{DynamicResource PromptLineSize}" Margin="0,3"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDimBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Dim}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding KeptText}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                               Visibility="{Binding KeptNote, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Caption}" Margin="2,10,0,0"
                               Visibility="{Binding ShowBusy, Converter={StaticResource VisibleWhen}}" />

                    <!-- choices -->
                    <WrapPanel Margin="0,22,0,0">
                        <Button x:Name="PrimaryButton" Style="{StaticResource Button.Large}" Margin="0,0,12,10" Click="OnPrimary" HorizontalContentAlignment="Left"
                                Visibility="{Binding HasPrimary, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding PrimaryText}">
                            <StackPanel Orientation="Horizontal">
                                <views:ButtonGlyph Kind="A" Size="Large" Always="True" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SecondaryButton" Style="{StaticResource Button.Large}" Margin="0,0,12,10" Click="OnSecondary" HorizontalContentAlignment="Left"
                                Visibility="{Binding HasSecondary, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding SecondaryText}">
                            <StackPanel Orientation="Horizontal">
                                <views:ButtonGlyph Kind="Y" Size="Large" Always="True" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SecondaryText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BackButton" Style="{StaticResource Button.Large}" Margin="0,0,0,10" Click="OnBack" HorizontalContentAlignment="Left"
                                Visibility="{Binding HasBack, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding BackText}">
                            <StackPanel Orientation="Horizontal">
                                <views:ButtonGlyph Kind="B" Size="Large" Always="True" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding BackText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</Window>
