<Window x:Class="OptimusVibe.App.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OptimusVibe.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Release notes" Icon="/Assets/app.ico"
        Width="900" Height="760" MinWidth="420" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource WindowFontSize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Popped-out release notes: read them at full size beside the app. Esc / B / Close shuts it; D-pad or right stick scrolls. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.CommandBindings>
        <CommandBinding Command="SystemCommands.MaximizeWindowCommand" Executed="OnMaximize" />
        <CommandBinding Command="SystemCommands.CloseWindowCommand" Executed="OnClose" />
    </Window.CommandBindings>

    <Grid>
        <Border Background="{DynamicResource PageBrush}" />
        <Border Background="{DynamicResource PageGlowBrush}" IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/app-64.png" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextDimBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Command="SystemCommands.MaximizeWindowCommand"
                            AutomationProperties.Name="Maximize" ToolTip="Maximize" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;" Command="SystemCommands.CloseWindowCommand"
                            AutomationProperties.Name="Close" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- the notes -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,8,20,0">
                <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False" Focusable="True" Foreground="{DynamicResource TextBrush}"
                                          AutomationProperties.Name="Release notes" />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,18">
                <Button x:Name="CloseButton" Style="{StaticResource Button.Quiet}" Click="OnCloseClick" MinWidth="120" AutomationProperties.Name="Close release notes">
                    <StackPanel Orientation="Horizontal">
                        <views:ButtonGlyph Kind="B" Size="Small" Margin="0,0,8,0" />
                        <TextBlock Text="Close" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
