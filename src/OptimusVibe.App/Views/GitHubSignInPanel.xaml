<UserControl x:Class="OptimusVibe.App.Views.GitHubSignInPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:OptimusVibe.App.Input">
    <!-- DataContext: GitHubAccountViewModel. Signed-in state, device-code sign-in, client id how-to, token paste. -->
    <StackPanel>
        <!-- ============================================ signed in -->
        <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricIcon}" Width="46" Height="46" CornerRadius="23" Background="{StaticResource InsetBrush}">
                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountText}" Style="{StaticResource Text.H3}" />
                <TextBlock Text="Your sign-in is kept safely in Windows Credential Manager." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Content="Sign out" Command="{Binding SignOutCommand}" VerticalAlignment="Center" />
        </Grid>

        <!-- ============================================ waiting for the device code to be entered -->
        <Border Style="{StaticResource Card.Inset}" Padding="28,24"
                Visibility="{Binding HasDeviceCode, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" FontSize="16.5">
                    <Run Text="On your phone or PC, go to" />
                    <Run Text="{Binding VerificationUri, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                    <Run Text="and enter this code:" />
                </TextBlock>
                <TextBlock Text="{Binding UserCode}" FontFamily="{StaticResource MonoFont}" FontSize="60" FontWeight="Bold"
                           Foreground="White" Margin="0,14,0,6" AutomationProperties.Name="Sign-in code" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="The code is on your clipboard too. This page carries on by itself once you approve Optimus-Vibe on GitHub." />
                <ProgressBar Style="{StaticResource BusyBar}" Margin="0,14,0,0" />
                <WrapPanel Margin="0,16,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenVerificationCommand}" Margin="0,0,8,8"
                            input:FocusCue.FocusWhenShown="True" AutomationProperties.Name="Open github.com/login/device" Content="Open GitHub" />
                    <Button Content="Copy code" Command="{Binding CopyCodeCommand}" Margin="0,0,8,8" />
                    <Button Content="Cancel" Style="{StaticResource Button.Quiet}" Command="{Binding CancelSignInCommand}" Margin="0,0,0,8" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============================================ not signed in -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasDeviceCode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- client id known: one big button -->
            <StackPanel Visibility="{Binding HasClientId, Converter={StaticResource VisibleWhen}}">
                <WrapPanel>
                    <Button x:Name="SignInButton" Style="{StaticResource Button.Large}" Command="{Binding SignInCommand}" Margin="0,0,8,8"
                            AutomationProperties.Name="Sign in with GitHub" Content="Sign in with GitHub" />
                    <Button Content="Change client id" Style="{StaticResource Button.Quiet}" Command="{Binding EditClientIdCommand}" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0"
                           Text="You get a short code to enter at github.com/login/device, from this device or your phone. No password is typed here." />
            </StackPanel>

            <!-- no client id: how-to -->
            <StackPanel Visibility="{Binding HasClientId, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource Text.H3}" Text="One-time setup: register a GitHub app" />
                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,6,0,0">
                    <Run Text="1. Register an OAuth app at" />
                    <Run Text="github.com/settings/developers" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                    <Run Text="(any name, homepage and callback URL)." />
                    <LineBreak />
                    <Run Text="2. Tick" />
                    <Run Text="Enable Device Flow" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text=" and save." />
                    <LineBreak />
                    <Run Text="3. Paste its" />
                    <Run Text="Client ID" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <Run Text="here (it isn't a secret)." />
                </TextBlock>
                <Grid Margin="0,14,0,0" MaxWidth="640" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" FontFamily="{StaticResource MonoFont}"
                             AutomationProperties.Name="GitHub OAuth client id" />
                    <Button Grid.Column="1" Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveClientIdCommand}" Margin="10,0,0,0" MinWidth="96" />
                </Grid>
                <Button Content="Open GitHub developer settings" Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding OpenDeveloperSettingsCommand}" />
            </StackPanel>

            <!-- token instead -->
            <Button Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding TogglePatCommand}">
                <TextBlock Text="Use a personal access token instead" />
            </Button>
            <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowPat, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Text.Dim}" Text="A classic token with the “repo” scope, or a fine-grained token with Contents: read and write on your config repo." />
                <Grid Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PatBox" MinWidth="320" AutomationProperties.Name="Personal access token" input:FocusCue.FocusWhenShown="True" />
                    <Button Grid.Column="1" Content="Use token" Style="{StaticResource Button.Primary}" Command="{Binding UsePatCommand}" Margin="10,0,0,0" />
                </Grid>
                <Button Content="Create a token on github.com" Style="{StaticResource Button.Quiet}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding OpenTokenSettingsCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding SignInError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="15" Margin="0,10,0,0"
                   Visibility="{Binding HasSignInError, Converter={StaticResource VisibleWhen}}" />
    </StackPanel>
</UserControl>
