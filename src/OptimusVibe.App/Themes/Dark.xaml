<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:input="clr-namespace:OptimusVibe.App.Input"
                    xmlns:conv="clr-namespace:OptimusVibe.App.Converters"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Boolean x:Key="True">True</sys:Boolean>
    <conv:PillRadiusConverter x:Key="PillRadius" />

    <!-- ============================================================ palette
         Navy-to-teal page, charcoal cards, one restrained blue. Green / cyan / purple exist ONLY for metric icons;
         orange exists ONLY for small "needs attention" dots. -->

    <!-- page -->
    <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E2436" Offset="0" />
        <GradientStop Color="#12344A" Offset="1" />
    </LinearGradientBrush>
    <!-- soft warm glow toward the lower-left -->
    <RadialGradientBrush x:Key="PageGlowBrush" Center="0.0,0.72" GradientOrigin="0.0,0.72" RadiusX="0.6" RadiusY="0.5">
        <GradientStop Color="#668A6420" Offset="0" />
        <GradientStop Color="#008A6420" Offset="1" />
    </RadialGradientBrush>

    <!-- surfaces -->
    <SolidColorBrush x:Key="CardBrush" Color="#F21C1D21" />
    <SolidColorBrush x:Key="InsetBrush" Color="#2A2C32" />
    <SolidColorBrush x:Key="CoverTileBrush" Color="#26282D" />
    <SolidColorBrush x:Key="CardActiveBrush" Color="#F21E2B40" />
    <SolidColorBrush x:Key="FeatureBrush" Color="#1167C9" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="SelectedPillBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="NavBrush" Color="#F21C1D21" />

    <!-- text -->
    <SolidColorBrush x:Key="TextBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#B9C0CB" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#8C94A1" />
    <SolidColorBrush x:Key="OnFeatureDimBrush" Color="#D7E6FA" />

    <!-- accent: primary actions, selection -->
    <Color x:Key="AccentColor">#3E91FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#203C66" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#8FBEFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FFFFFF" />

    <!-- metric icons only -->
    <SolidColorBrush x:Key="MetricGreenBrush" Color="#7ED321" />
    <SolidColorBrush x:Key="MetricCyanBrush" Color="#29B6F6" />
    <SolidColorBrush x:Key="MetricPurpleBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="MetricGlyphBrush" Color="#10151C" />

    <!-- needs attention dots; errors -->
    <SolidColorBrush x:Key="AttentionBrush" Color="#FF6B1A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B2226" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="#D9484F" />

    <SolidColorBrush x:Key="TonalBrush" Color="#2D2F36" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#26000000" />
    <SolidColorBrush x:Key="BackdropBrush" Color="#C0060E16" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================================================ text -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="Text.Dim" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="Text.Unit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <!-- ============================================================ containers -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="26" />
    </Style>
    <!-- The one saturated card per screen. -->
    <Style x:Key="Card.Feature" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource FeatureBrush}" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <!-- A soft inset on a card (previews, forms); no outline. -->
    <Style x:Key="Card.Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <Style x:Key="Dot" TargetType="Border">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource TextFaintBrush}" />
    </Style>
    <Style x:Key="Dot.Attention" TargetType="Border" BasedOn="{StaticResource Dot}">
        <Setter Property="Background" Value="{StaticResource AttentionBrush}" />
    </Style>

    <!-- Round coloured icon in front of a metric. Child: a TextBlock with the glyph. -->
    <Style x:Key="MetricIcon" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ buttons -->
    <!-- One template for every button: pill, hover/press overlay, and a 2px white ring that only shows while the user
         navigates with keyboard or gamepad (FocusCue.Show). -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource TonalBrush}" />
        <Setter Property="Padding" Value="22,8" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" />
                        <Border x:Name="Overlay" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="Ring" Margin="-3" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderThickness="2"
                                BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- default = soft tonal pill -->
    <Style TargetType="Button" BasedOn="{StaticResource Btn}" />

    <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- quiet text action -->
    <Style x:Key="Button.Quiet" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style x:Key="Button.Large" TargetType="ButtonBase" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="Padding" Value="28,10" />
        <Setter Property="FontSize" Value="16.5" />
    </Style>
    <!-- round icon-only button -->
    <Style x:Key="Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- floating action button -->
    <Style x:Key="Button.Fab" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource NavBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="Button.Fab.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Fab}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Segmented filter / tab strip: a pill with a subtle outline; the selected item is a lighter pill. Tag=True = selected. -->
    <Style x:Key="Button.Segment" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Background" Value="{StaticResource SelectedPillBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SegmentStrip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Bottom navigation item: icon over a short label; Tag=True = current page. -->
    <Style x:Key="Button.NavItem" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="62" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Background" Value="{StaticResource SelectedPillBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Choice (settings): a soft rounded block; Tag=True = current choice. -->
    <Style x:Key="Button.Choice" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22" />
                        <Border x:Name="Overlay" CornerRadius="22" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="Ring" Margin="-3" CornerRadius="25" BorderThickness="2"
                                BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ library grid -->
    <Style x:Key="TileGrid" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <!-- no scroller of its own: the library page scrolls as a whole -->
                    <ItemsPresenter Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A cover tile: 2px focus ring + a small grow while the gamepad / keyboard is on it. -->
    <Style x:Key="LibraryTile" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,8,0,10" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.4" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" HorizontalAlignment="Left">
                        <ContentPresenter />
                        <Border x:Name="Ring" Margin="-6,-6,-6,36" CornerRadius="28" BorderThickness="2"
                                BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocused" Value="True" />
                    <Condition Property="input:FocusCue.Show" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Panel.ZIndex" Value="1" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ text box -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="21" BorderThickness="2"
                                BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="21" BorderThickness="2"
                                BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ check box -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="6,0">
                            <Border x:Name="Box" Width="26" Height="26" CornerRadius="13" BorderThickness="2"
                                    BorderBrush="{StaticResource TextFaintBrush}" Background="Transparent"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 5,12 L 10,17 L 19,7" Stroke="White" StrokeThickness="2.5"
                                      Visibility="Collapsed" Margin="-1,-1,0,0" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </Border>
                            <ContentPresenter Margin="12,0,6,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <Border x:Name="Ring" Margin="-2" CornerRadius="24" BorderThickness="2"
                                BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ game list (Manage view, repo picker) -->
    <Style x:Key="GameList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
        <!-- Let the gamepad (and arrow keys) leave the list sideways into the detail pane. -->
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" PanningMode="VerticalOnly">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="20" Background="Transparent" Padding="18,12" MinHeight="62">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="20" BorderThickness="2" BorderBrush="{StaticResource FocusBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InsetBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tabs (same outlined pill strip as the library filters) -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SegmentStrip}">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,18,0,0"
                                          KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="Transparent" Padding="24,0" MinHeight="48">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderThickness="2"
                                BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedPillBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scroll bars -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="4" Background="#44FFFFFF" Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#70FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#26272C" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BusyBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Focusable" Value="False" />
    </Style>

</ResourceDictionary>
