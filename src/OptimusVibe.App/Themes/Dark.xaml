<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:input="clr-namespace:OptimusVibe.App.Input"
                    xmlns:conv="clr-namespace:OptimusVibe.App.Converters"
                    xmlns:svc="clr-namespace:OptimusVibe.App.Services"
                    xmlns:views="clr-namespace:OptimusVibe.App.Views"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Boolean x:Key="True">True</sys:Boolean>
    <conv:PillRadiusConverter x:Key="PillRadius" />

    <!-- Layout switches: set on a plain container (Grid / StackPanel; never with a local Visibility) to show it in one density only. -->
    <Style x:Key="Only.Comfortable" TargetType="FrameworkElement">
        <Style.Triggers>
            <Trigger Property="svc:Density.IsCompact" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Only.Compact" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="svc:Density.IsCompact" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Colours, brushes, gradients and glows are NOT defined here: they live in the swappable Palette.*.xaml dictionaries
         (App.xaml merges the active one before this file; ThemeManager swaps it). Every palette reference below is a
         DynamicResource so a theme change restyles the open window. -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================================================ text -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource PageTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.OverlayTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
        <Setter Property="FontSize" Value="{DynamicResource OverlayTitleSize}" />
    </Style>
    <Style x:Key="Text.Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource LeadSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource LeadLineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource H2Size}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="FontSize" Value="{DynamicResource CardTitleSize}" />
    </Style>
    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="{DynamicResource BodyLineHeight}" />
    </Style>
    <Style x:Key="Text.Dim" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource DimSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource DimLineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="Text.Unit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>

    <!-- ============================================================ containers -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
    </Style>
    <!-- The one saturated card per screen. -->
    <Style x:Key="Card.Feature" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource FeatureBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FeatureBorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FeatureTextBrush}" />
    </Style>
    <!-- A soft inset on a card (previews, forms); no outline. -->
    <Style x:Key="Card.Inset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsetRadius}" />
        <Setter Property="Padding" Value="{DynamicResource InsetPadding}" />
    </Style>

    <!-- A modal panel (report, Steam review, diff preview): centred and capped on the desktop, the full height with little padding when compact. -->
    <Style x:Key="Overlay.Card" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="MaxWidth" Value="{DynamicResource OverlayMaxWidth}" />
        <Setter Property="Margin" Value="{DynamicResource OverlayMargin}" />
        <Setter Property="Padding" Value="{DynamicResource OverlayPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="svc:Density.IsCompact" Value="True">
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dot" TargetType="Border">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style x:Key="Dot.Attention" TargetType="Border" BasedOn="{StaticResource Dot}">
        <Setter Property="Background" Value="{DynamicResource AttentionBrush}" />
    </Style>

    <!-- Round coloured icon in front of a metric. Child: a TextBlock with the glyph. -->
    <Style x:Key="MetricIcon" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource MetricIconSize}" />
        <Setter Property="Height" Value="{DynamicResource MetricIconSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MetricIconRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ buttons -->
    <!-- One template for every button: pill, hover/press overlay, and a 2px white ring that only shows while the user
         navigates with keyboard or gamepad (FocusCue.Show). -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource TonalBrush}" />
        <Setter Property="Padding" Value="{DynamicResource BtnPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource BtnMinHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource BtnMinWidth}" />
        <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" />
                        <Border x:Name="Overlay" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="Ring" Margin="-3" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderThickness="2"
                                BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- default = soft tonal pill -->
    <Style TargetType="Button" BasedOn="{StaticResource Btn}" />

    <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style x:Key="Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- quiet text action -->
    <Style x:Key="Button.Quiet" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="Padding" Value="{DynamicResource QuietPadding}" />
    </Style>
    <Style x:Key="Button.Large" TargetType="ButtonBase" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinHeight" Value="{DynamicResource BtnLargeMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource BtnLargePadding}" />
        <Setter Property="FontSize" Value="{DynamicResource BtnLargeFontSize}" />
    </Style>
    <!-- round icon-only button -->
    <Style x:Key="Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource IconBtnSize}" />
        <Setter Property="Height" Value="{DynamicResource IconBtnSize}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="{DynamicResource IconBtnGlyphSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- floating action button -->
    <Style x:Key="Button.Fab" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource NavBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource FabSize}" />
        <Setter Property="Height" Value="{DynamicResource FabSize}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FabGlyphSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="Button.Fab.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Fab}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- Segmented filter / tab strip: a pill with a subtle outline; the selected item is a lighter pill. Tag=True = selected. -->
    <Style x:Key="Button.Segment" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource SegmentMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource SegmentPadding}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SegmentStrip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Bottom navigation item: icon over a short label; Tag=True = current page. -->
    <Style x:Key="Button.NavItem" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="MinWidth" Value="{DynamicResource NavItemMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource NavItemMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource NavItemPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource NavFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Choice (settings): a soft rounded block; Tag=True = current choice. -->
    <Style x:Key="Button.Choice" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
        <Setter Property="Padding" Value="{DynamicResource ChoicePadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ChoiceMinHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22" />
                        <Border x:Name="Overlay" CornerRadius="22" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="Ring" Margin="-3" CornerRadius="25" BorderThickness="2"
                                BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ library grid -->
    <Style x:Key="TileGrid" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <!-- no scroller of its own: the library page scrolls as a whole -->
                    <ItemsPresenter Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A cover tile: 2px focus ring + a small grow while the gamepad / keyboard is on it. -->
    <Style x:Key="LibraryTile" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="{DynamicResource TileMargin}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.4" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" HorizontalAlignment="Left">
                        <ContentPresenter />
                        <Border x:Name="Ring" Margin="{DynamicResource TileRingMargin}" CornerRadius="{DynamicResource TileRingRadius}" BorderThickness="2"
                                BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocused" Value="True" />
                    <Condition Property="input:FocusCue.Show" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Panel.ZIndex" Value="1" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ text box -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="21" BorderThickness="2"
                                BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="18">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="21" BorderThickness="2"
                                BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ check box -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource CheckMinHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="6,0">
                            <Border x:Name="Box" Width="26" Height="26" CornerRadius="13" BorderThickness="2"
                                    BorderBrush="{DynamicResource TextFaintBrush}" Background="Transparent"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 5,12 L 10,17 L 19,7" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.5"
                                      Visibility="Collapsed" Margin="-1,-1,0,0" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </Border>
                            <ContentPresenter Margin="12,0,6,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <Border x:Name="Ring" Margin="-2" CornerRadius="24" BorderThickness="2"
                                BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ game list (Manage view, repo picker) -->
    <Style x:Key="GameList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
        <!-- Let the gamepad (and arrow keys) leave the list sideways into the detail pane. -->
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" PanningMode="VerticalOnly">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource InsetRadius}" Background="Transparent" Padding="{DynamicResource ListItemPadding}" MinHeight="{DynamicResource ListItemMinHeight}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="{DynamicResource InsetRadius}" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InsetBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tabs (same outlined pill strip as the library filters) -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <views:ButtonGlyph Kind="LB" Margin="0,0,8,0" />
                            <Border Style="{StaticResource SegmentStrip}">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <views:ButtonGlyph Kind="RB" Margin="8,0,0,0" />
                        </StackPanel>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="{DynamicResource TabContentMargin}"
                                          KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TabFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="Transparent" Padding="{DynamicResource TabPadding}" MinHeight="{DynamicResource TabMinHeight}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderThickness="2"
                                BorderBrush="{DynamicResource FocusBrush}" Effect="{DynamicResource FocusGlow}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="input:FocusCue.Show" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scroll bars -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="4" Background="{DynamicResource ScrollThumbBrush}" Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ToolTipBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BusyBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Focusable" Value="False" />
    </Style>


    <!-- ============================================================ settings sections -->
    <Style x:Key="Button.SectionHeader" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="HorizontalOnlyScroller" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="HorizontalOnly" />
    </Style>

    <Style TargetType="views:SettingsSection">
        <Setter Property="Margin" Value="{DynamicResource CardMargin}" />
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SettingsSection">
                    <Border Style="{StaticResource Card}" Padding="{DynamicResource SectionPadding}">
                        <StackPanel>
                            <TextBlock x:Name="Title" Text="{TemplateBinding Header}" Style="{StaticResource Text.H2}" />
                            <ToggleButton x:Name="HeaderButton" Style="{StaticResource Button.SectionHeader}" Visibility="Collapsed"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{TemplateBinding Header}">
                                <Grid>
                                    <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="14" FontWeight="Normal"
                                               Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="svc:Density.IsCompact" Value="True">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Body" Property="Margin" Value="0,6,0,0" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False" />
                                <Condition Property="svc:Density.IsCompact" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
