    <sys:Double x:Key="IntentCardWidth">270</sys:Double>
    <Thickness x:Key="BlockGapMd">0,8,0,0</Thickness>
    <Thickness x:Key="AskMargin">4,6,0,0</Thickness>
    <sys:Double x:Key="LabMaxWidth">1180</sys:Double>
    <sys:Double x:Key="LabListMaxHeight">130</sys:Double>
    <sys:Double x:Key="ThemePreviewHeight">64</sys:Double>
    <Thickness x:Key="SectionPadding">14,5</Thickness>
    <Thickness x:Key="PromptMargin">12</Thickness>
    <sys:Double x:Key="PromptLineSize">15</sys:Double>
    <Thickness x:Key="PromptInsetPadding">22,10</Thickness>
</ResourceDictionary>
