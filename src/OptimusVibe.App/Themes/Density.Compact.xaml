    <sys:Double x:Key="CheckMinHeight">42</sys:Double>
    <sys:Double x:Key="TabMinHeight">40</sys:Double>
    <Thickness x:Key="TabPadding">16,0</Thickness>
    <sys:Double x:Key="ListItemMinHeight">48</sys:Double>
    <Thickness x:Key="ListItemPadding">14,6</Thickness>
    <Thickness x:Key="TileMargin">0,3,0,5</Thickness>
    <CornerRadius x:Key="MetricIconRadius">16</CornerRadius>
    <Thickness x:Key="QuietPadding">12,6</Thickness>
    <sys:Double x:Key="BtnLargeFontSize">15</sys:Double>
    <Thickness x:Key="TileRingMargin">-5</Thickness>
    <CornerRadius x:Key="TileRingRadius">20</CornerRadius>
    <sys:Double x:Key="TabFontSize">14.5</sys:Double>
    <Thickness x:Key="ManageListMargin">20,4,0,6</Thickness>
    <Thickness x:Key="ManageListPadding">10,10,10,8</Thickness>
    <Thickness x:Key="ManageListTitleMargin">10,0,0,6</Thickness>
    <Thickness x:Key="FilterMargin">0,6,0,4</Thickness>
    <sys:Double x:Key="SyncMinHeight">40</sys:Double>
    <Thickness x:Key="SyncPadding">12,0</Thickness>
    <Thickness x:Key="TileListMargin">-14,14,-14,0</Thickness>
    <Thickness x:Key="TileListPadding">14,0,14,6</Thickness>
    <sys:Double x:Key="MetricGlyphSize">14</sys:Double>
    <sys:Double x:Key="ToggleMaxWidth">1060</sys:Double>
    <sys:Double x:Key="DetailCoverWidth">150</sys:Double>
    <sys:Double x:Key="DetailCoverHeight">225</sys:Double>
    <Thickness x:Key="DetailTextMargin">20,0,0,0</Thickness>
