<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ============================================================ density: compact
         For short windows (about 1280x720 DIPs: the ROG Xbox Ally X at 150%). Same keys as Density.Comfortable.xaml.
         Every control stays at least 40 DIPs tall / wide so a thumb or the controller can still hit it. -->

    <!-- type -->
    <sys:Double x:Key="WindowFontSize">14</sys:Double>
    <sys:Double x:Key="PageTitleSize">24</sys:Double>
    <sys:Double x:Key="LeadSize">14.5</sys:Double>
    <sys:Double x:Key="LeadLineHeight">20</sys:Double>
    <sys:Double x:Key="H2Size">17</sys:Double>
    <sys:Double x:Key="H3Size">15</sys:Double>
    <sys:Double x:Key="BodySize">14</sys:Double>
    <sys:Double x:Key="BodyLineHeight">19</sys:Double>
    <sys:Double x:Key="DimSize">13.5</sys:Double>
    <sys:Double x:Key="DimLineHeight">18</sys:Double>
    <sys:Double x:Key="CaptionSize">12.5</sys:Double>
    <sys:Double x:Key="MetricValueSize">24</sys:Double>
    <sys:Double x:Key="MetricUnitSize">14</sys:Double>
    <sys:Double x:Key="MetricIconSize">32</sys:Double>
    <sys:Double x:Key="CardTitleSize">17</sys:Double>
    <sys:Double x:Key="OverlayTitleSize">22</sys:Double>
    <sys:Double x:Key="HeaderTitleSize">20</sys:Double>
    <sys:Double x:Key="TileNameSize">13.5</sys:Double>

    <!-- surfaces -->
    <CornerRadius x:Key="CardRadius">20</CornerRadius>
    <CornerRadius x:Key="InsetRadius">14</CornerRadius>
    <CornerRadius x:Key="TileRadius">16</CornerRadius>
    <CornerRadius x:Key="TileShadeRadius">0,0,16,16</CornerRadius>
    <CornerRadius x:Key="NavRadius">30</CornerRadius>
    <CornerRadius x:Key="BannerRadius">20</CornerRadius>
    <Thickness x:Key="CardPadding">16,12</Thickness>
    <Thickness x:Key="InsetPadding">12,8</Thickness>
    <Thickness x:Key="CardMargin">0,0,0,8</Thickness>
    <Thickness x:Key="BannerPadding">16,6</Thickness>

    <!-- window caption buttons -->
    <sys:Double x:Key="CaptionBtnWidth">40</sys:Double>
    <sys:Double x:Key="CaptionBtnHeight">28</sys:Double>

    <!-- page frames -->
    <Thickness x:Key="HeaderMargin">20,6,16,0</Thickness>
    <Thickness x:Key="BannerMargin">20,4,20,2</Thickness>
    <Thickness x:Key="PageMargin">20,2,20,4</Thickness>
    <Thickness x:Key="DetailMargin">20,2,20,6</Thickness>
    <Thickness x:Key="StripMargin">12,2,20,2</Thickness>
    <Thickness x:Key="SettingsMargin">14,2,20,12</Thickness>
    <Thickness x:Key="NavRowMargin">20,4,20,8</Thickness>
    <Thickness x:Key="TabContentMargin">0,10,0,0</Thickness>
    <Thickness x:Key="TabsMargin">0,10,0,0</Thickness>
    <Thickness x:Key="BlockGap">0,10,0,0</Thickness>

    <!-- overlays (report, Steam review, diff preview) -->
    <Thickness x:Key="OverlayMargin">8</Thickness>
    <Thickness x:Key="OverlayPadding">22,14</Thickness>
    <sys:Double x:Key="OverlayMaxWidth">1180</sys:Double>
    <sys:Double x:Key="OverlayListMaxHeight">100000</sys:Double>
    <sys:Double x:Key="PromptListMaxHeight">240</sys:Double>
    <Thickness x:Key="PromptPadding">28,18</Thickness>
    <sys:Double x:Key="PromptWidth">1100</sys:Double>

    <!-- controls -->
    <sys:Double x:Key="BtnMinHeight">42</sys:Double>
    <sys:Double x:Key="BtnMinWidth">42</sys:Double>
    <sys:Double x:Key="BtnLargeMinHeight">46</sys:Double>
    <sys:Double x:Key="BtnFontSize">14</sys:Double>
    <Thickness x:Key="BtnPadding">16,6</Thickness>
    <Thickness x:Key="BtnLargePadding">22,8</Thickness>
    <sys:Double x:Key="IconBtnSize">40</sys:Double>
    <sys:Double x:Key="IconBtnGlyphSize">17</sys:Double>
    <sys:Double x:Key="FabSize">52</sys:Double>
    <sys:Double x:Key="FabGlyphSize">20</sys:Double>
    <sys:Double x:Key="SegmentMinHeight">40</sys:Double>
    <Thickness x:Key="SegmentPadding">14,0</Thickness>
    <sys:Double x:Key="SegmentGlyphSize">17</sys:Double>
    <sys:Double x:Key="ChoiceMinHeight">44</sys:Double>
    <Thickness x:Key="ChoicePadding">14,8</Thickness>
    <sys:Double x:Key="NavItemMinHeight">48</sys:Double>
