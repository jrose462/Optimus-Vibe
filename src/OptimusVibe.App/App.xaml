<Application x:Class="OptimusVibe.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OptimusVibe.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- the active palette comes first (ThemeManager swaps it), then the styles that reference it with DynamicResource -->
                <ResourceDictionary Source="Themes/Palette.Default.xaml" />
                <!-- the active density comes next (Density.cs swaps it): spacing, radii, type sizes, control heights -->
                <ResourceDictionary Source="Themes/Density.Comfortable.xaml" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VisibleWhenConverter x:Key="VisibleWhen" />
            <conv:InverseBoolConverter x:Key="Not" />
            <conv:MarkdownDocumentConverter x:Key="MarkdownDocument" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
