<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop / handheld GUI: pick presets per game, apply now, manage manual saves. Mouse, touch and gamepad. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OptimusVibe</AssemblyName>
    <RootNamespace>OptimusVibe.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Save-crystal icon (taskbar, Start, Explorer); regenerate with tools/IconGen. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptimusVibe.Core\OptimusVibe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon and the header logo load these as WPF resources (pack://application:,,,/Assets/...). -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects leave System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
