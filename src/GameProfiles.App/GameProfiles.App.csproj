<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop / handheld GUI: pick presets per game, apply now, manage manual saves. Mouse, touch and gamepad. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameProfilesApp</AssemblyName>
    <RootNamespace>GameProfiles.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameProfiles.Core\GameProfiles.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects leave System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
