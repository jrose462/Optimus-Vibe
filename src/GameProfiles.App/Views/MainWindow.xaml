<Window x:Class="GameProfiles.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameProfiles.App.Views"
        xmlns:vm="clr-namespace:GameProfiles.App.ViewModels"
        Title="GameProfiles"
        Width="1360" Height="880" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ header -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <!-- Separate column so the long config path trims instead of running under the buttons. -->
                <StackPanel Margin="56,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GameProfiles" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge.Accent}" ToolTip="{Binding DeviceDescription}" Margin="14,2,0,0"
                                Visibility="{Binding Session, Converter={StaticResource VisibleWhen}}">
                            <TextBlock>
                                <Run Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" />
                                <Run Text="{Binding DeviceName, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="·" />
                                <Run Text="{Binding DeviceReason, Mode=OneWay}" FontWeight="Normal" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,5,0,0" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigRoot}"
                               Visibility="{Binding ShowConfigLine, Converter={StaticResource VisibleWhen}}">
                        <Run Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" />
                        <Run Text="Config:" />
                        <Run Text="{Binding ConfigRoot, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Library | Manage -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13"
                            Padding="3" Margin="0,0,16,0" Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Segment}" Tag="{Binding IsLibraryMode}" Command="{Binding ShowLibraryCommand}"
                                    AutomationProperties.Name="Library view" ToolTip="Cover grid for playing — made for a controller">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Library" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Segment}" Tag="{Binding IsLibraryMode, Converter={StaticResource Not}}" Command="{Binding ShowManageCommand}"
                                    AutomationProperties.Name="Manage view" ToolTip="Game list with presets side by side">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Manage" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}" ToolTip="Reload config, rescan launchers and re-detect the device (F5 / View button)" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Sync" Command="{Binding SyncCommand}" ToolTip="Commit manual saves, pull and push the config repo (Y)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Sync" />
                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="7,0" Background="#33FFFFFF">
                                <TextBlock Text="Y" Foreground="{StaticResource WarnBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Settings" Command="{Binding OpenSettingsCommand}" Margin="10,0,0,0" Padding="13,8"
                            ToolTip="Settings — sync, GitHub, launchers, device (Start / ☰ button, Ctrl+,)"
                            Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}"
                     Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />

        <!-- ============================================================ steam banner (non-modal) -->
        <Border Grid.Row="2" Background="{StaticResource WarnSoftBrush}" BorderBrush="#5A4A2A" BorderThickness="0,0,0,1" Padding="22,10"
                Visibility="{Binding HasSteamBanner, Converter={StaticResource VisibleWhen}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="15.5" TextWrapping="Wrap" Margin="0,0,16,0">
                    <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}" />
                    <Run Text="{Binding SteamBannerText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                    <Run Text="— they make games started from Steam use your presets." Foreground="{StaticResource TextDimBrush}" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ApplySteamButton" Style="{StaticResource Button.Primary}" Command="{Binding ApplySteamCommand}" AutomationProperties.Name="Close Steam and apply">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Close Steam &amp; apply" />
                        </StackPanel>
                    </Button>
                    <Button Content="Later" Style="{StaticResource Button.Ghost}" Command="{Binding DismissSteamCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ content -->
        <Grid Grid.Row="3">
            <!-- loading -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="44" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Detecting this device and loading games…" Style="{StaticResource Text.H3}" Margin="0,14,0,0" />
            </StackPanel>

            <!-- first run / setup -->
            <views:SetupView Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}" />

            <!-- library -->
            <views:LibraryView x:Name="LibraryPage" DataContext="{Binding Library}"
                               Visibility="{Binding DataContext.IsLibraryPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

            <!-- one library game -->
            <views:LibraryDetailView x:Name="LibraryDetail"
                                     Visibility="{Binding IsDetailPage, Converter={StaticResource VisibleWhen}}" />

            <!-- settings -->
            <views:SettingsView x:Name="SettingsPage" DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

            <!-- manage (list + detail) -->
            <Grid Visibility="{Binding IsManagePage, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,16,10,10">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" Margin="12,0,0,8">
                            <Run Text="GAMES" />
                            <Run Text="{Binding Games.Count, Mode=OneWay}" />
                        </TextBlock>
                        <ListBox x:Name="GameList" Style="{StaticResource GameList}" ItemContainerStyle="{StaticResource GameListItem}"
                                 ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding StoreText}" Style="{StaticResource Text.Caption}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BadgeKind}" Value="Recommended">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BadgeKind}" Value="Manual">
                                                                <Setter Property="Background" Value="{StaticResource ManualSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource ManualBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BadgeKind}" Value="Error">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BadgeText}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            </Border>
                                            <TextBlock Text="{Binding BadgeSubText}" Style="{StaticResource Text.Caption}" FontWeight="Normal"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding BadgeSubText, Converter={StaticResource VisibleWhen}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <views:GameDetailView x:Name="Detail" Grid.Column="1" DataContext="{Binding SelectedDetail}"
                                      Visibility="{Binding DataContext.SelectedDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                <!-- no games -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="620" Padding="32"
                        Visibility="{Binding Games.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="No games configured yet" Style="{StaticResource Text.H2}" />
                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                                   Text="Ask Claude to add one with the game-settings skill (/game-settings-recommender &lt;game&gt;). It writes config\games\&lt;id&gt;.yaml with presets for the desktop and the Ally X; then Sync and Refresh here." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- starting a game -->
            <Grid DataContext="{Binding Launching}"
                  Visibility="{Binding DataContext.IsLaunching, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                <Border Background="#E60A0C10" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="200" Height="300">
                        <Border CornerRadius="16" Background="{Binding Fallback}">
                            <TextBlock Text="{Binding Initials}" FontSize="60" FontWeight="Bold" Foreground="#E6FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="16" Visibility="{Binding HasArt, Converter={StaticResource VisibleWhen}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="#7C6CFF" />
                        </Grid.Effect>
                    </Grid>
                    <TextBlock HorizontalAlignment="Center" Margin="0,26,0,0" FontSize="26" FontWeight="SemiBold">
                        <Run Text="Starting" />
                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="…" />
                    </TextBlock>
                    <TextBlock Text="{Binding PlayHint}" Style="{StaticResource Text.Dim}" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <ProgressBar Style="{StaticResource BusyBar}" Width="260" Margin="0,22,0,0" />
                </StackPanel>
            </Grid>

            <!-- toast -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" MaxWidth="560"
                    Background="{StaticResource CardRaisedBrush}" CornerRadius="14" BorderThickness="1"
                    Visibility="{Binding HasToast, Converter={StaticResource VisibleWhen}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid Margin="18,12,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ToastText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Focusable="False" Margin="8,0,0,0" Padding="10,4"
                            Command="{Binding DismissToastCommand}" ToolTip="Dismiss">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ status bar -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="14"
                           ToolTip="{Binding StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="{Binding ControllerHint}" />
            </Grid>
        </Border>
    </Grid>
</Window>
