<UserControl x:Class="GameProfiles.App.Views.LibraryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GameProfiles.App.Views"
             xmlns:input="clr-namespace:GameProfiles.App.Input">
    <!-- DataContext: MainViewModel. One library game: back, cover, the manage toggle, then its presets (or why there are none). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- strip -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid DataContext="{Binding DetailTile}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource Button.Ghost}" VerticalAlignment="Center" AutomationProperties.Name="Back to library"
                        Command="{Binding DataContext.BackToLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Library" FontSize="16" />
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="7,0" Background="#33FFFFFF">
                            <TextBlock Text="B" Foreground="{StaticResource DangerBrush}" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- mini cover -->
                <Grid Grid.Column="1" Width="44" Height="66" Margin="14,0,14,0" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="{Binding Fallback}">
                        <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="8" Visibility="{Binding HasArt, Converter={StaticResource VisibleWhen}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="21" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" FontSize="14" Margin="0,3,0,0">
                        <Run Text="{Binding StoreText, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding StatusText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- manage toggle -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" MaxWidth="440" Margin="16,0,0,0"
                            Visibility="{Binding CanToggleManaged, Converter={StaticResource VisibleWhen}}">
                    <CheckBox x:Name="ManageToggle" Content="Manage this game's settings" FontSize="16" FontWeight="SemiBold"
                              IsChecked="{Binding IsManaged, Mode=OneWay}"
                              Command="{Binding SetManagedCommand}"
                              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                              ToolTip="Off: GameProfiles never touches this game — it starts normally and its Steam launch option is removed. Synced to your other devices." />
                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" FontSize="13.5" Margin="44,0,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource WarnBrush}"
                               Visibility="{Binding SuggestOptOut, Converter={StaticResource VisibleWhen}}"
                               Text="This game keeps graphics settings per machine — you can safely opt out." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- presets (configured games) -->
        <views:GameDetailView x:Name="GameDetail" Grid.Row="1" DataContext="{Binding SelectedDetail}"
                              Visibility="{Binding DataContext.DetailHasConfig, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />

        <!-- no config yet / opted out -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding DetailHasConfig, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <Grid DataContext="{Binding DetailTile}" Margin="28,24" MaxWidth="1000" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="220" Height="330" VerticalAlignment="Top">
                    <Border CornerRadius="14" Background="{Binding Fallback}">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <TextBlock Text="{Binding Initials}" FontSize="58" FontWeight="Bold" Foreground="#E6FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="14" Visibility="{Binding HasArt, Converter={StaticResource VisibleWhen}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                    <Button x:Name="PlayButton" Style="{StaticResource Button.Large}" HorizontalAlignment="Left" Margin="0,18,0,0" MinWidth="180"
                            Command="{Binding PlayCommand}" AutomationProperties.Name="Play" input:FocusCue.FocusWhenShown="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding PlayHint}" Style="{StaticResource Text.Dim}" FontSize="15" Margin="0,8,0,0" />

                    <!-- queued for Claude -->
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="22,18"
                            Visibility="{Binding IsQueued, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.H3}" FontSize="18">
                                <Run Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}" />
                                <Run Text="Queued for Claude" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Dim}" FontSize="15" Margin="0,8,0,0">
                                <Run Text="GameProfiles has no presets for this game yet. It was added to" />
                                <Run Text="config\requests.yaml" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextBrush}" />
                                <Run Text="(synced). Ask Claude to" />
                                <Run Text="“process GameProfiles requests”" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <Run Text="— it researches the game's settings and writes presets for the desktop and the Ally. Until then the game starts normally." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- opted out -->
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="22,18"
                            Visibility="{Binding IsManaged, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="Opted out" Style="{StaticResource Text.H3}" FontSize="18" />
                            <TextBlock Style="{StaticResource Text.Dim}" FontSize="15" Margin="0,8,0,0"
                                       Text="GameProfiles leaves this game alone on every device: no presets are applied, no request is queued, and its Steam launch option is removed. Turn on “Manage this game's settings” above to change that." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
