<UserControl x:Class="GameProfiles.App.Views.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:GameProfiles.App.Input"
             xmlns:vm="clr-namespace:GameProfiles.App.ViewModels">
    <!-- DataContext: GameDetailViewModel -->
    <UserControl.Resources>

        <!-- Badges shared by recommended and manual cards. -->
        <DataTemplate x:Key="CardBadges" DataType="{x:Type vm:PresetCardViewModel}">
            <WrapPanel>
                <Border Style="{StaticResource Badge.Active}" Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}}">
                    <TextBlock>
                        <Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}" />
                        <Run Text="Active" />
                    </TextBlock>
                </Border>
                <Border Style="{StaticResource Badge.Accent}" Visibility="{Binding IsDefault, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Device default" />
                </Border>
                <Border Style="{StaticResource Badge}" Visibility="{Binding FpsText, Converter={StaticResource VisibleWhen}}">
                    <TextBlock>
                        <Run Text="{Binding FpsText, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </WrapPanel>
        </DataTemplate>

        <!-- ======================================================== recommended preset card -->
        <DataTemplate x:Key="RecommendedCard" DataType="{x:Type vm:PresetCardViewModel}">
            <Border Width="372" MinHeight="250" Margin="0,0,18,18">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="#2E7A5E" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Label}" Style="{StaticResource Text.H2}" FontSize="22" />
                    <ContentControl DockPanel.Dock="Top" Margin="0,10,0,0" Focusable="False" IsTabStop="False"
                                    Content="{Binding}" ContentTemplate="{StaticResource CardBadges}" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Button AutomationProperties.Name="Use" Style="{StaticResource Button.Primary}" Command="{Binding UseCommand}" Margin="0,0,10,8" MinWidth="96"
                                ToolTip="Remember this preset for this game on this device — applied on the next launch">
                            <TextBlock Text="{Binding UseText}" />
                        </Button>
                        <Button Content="Apply now" Command="{Binding ApplyCommand}" Margin="0,0,10,8"
                                ToolTip="Write these settings into the game's files now (shows the changes first)" />
                        <Button Content="Preview" Style="{StaticResource Button.Ghost}" Command="{Binding PreviewCommand}" Margin="0,0,0,8"
                                ToolTip="Show what would change" />
                    </WrapPanel>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Dim}"
                                   Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ======================================================== manual save card -->
        <DataTemplate x:Key="ManualCard" DataType="{x:Type vm:PresetCardViewModel}">
            <Border Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="#2E7A5E" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- title row / rename -->
                    <Grid Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.H2}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <ContentControl Grid.Column="1" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                        Content="{Binding}" ContentTemplate="{StaticResource CardBadges}" />
                    </Grid>
                    <Grid Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="460" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" FontSize="17"
                                 input:FocusCue.FocusWhenShown="True">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Save name" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                Command="{Binding ConfirmRenameCommand}" />
                        <Button Grid.Column="2" Content="Cancel" Margin="10,0,0,0" Command="{Binding CancelRenameCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,8,0,0"
                               Visibility="{Binding MetaText, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Dim}" Margin="0,8,0,0"
                               Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />

                    <!-- actions -->
                    <WrapPanel Margin="0,14,0,0" Visibility="{Binding IsIdle, Converter={StaticResource VisibleWhen}}">
                        <Button AutomationProperties.Name="Use" Style="{StaticResource Button.Primary}" Command="{Binding UseCommand}" Margin="0,0,10,8" MinWidth="96"
                                ToolTip="Remember this save for this game on this device — applied on the next launch">
                            <TextBlock Text="{Binding UseText}" />
                        </Button>
                        <Button Content="Apply now" Command="{Binding ApplyCommand}" Margin="0,0,10,8" />
                        <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,10,8" Style="{StaticResource Button.Ghost}" />
                        <Button AutomationProperties.Name="Update from current" Command="{Binding UpdateFromCurrentCommand}" Margin="0,0,10,8"
                                ToolTip="Overwrite this save with the game's current settings (and make it active)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Update from current" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Rename" Command="{Binding BeginRenameCommand}" Margin="0,0,10,8" Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Rename" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Delete" Command="{Binding BeginDeleteCommand}" Margin="0,0,0,8" Style="{StaticResource Button.Ghost}"
                                Foreground="{StaticResource DangerBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- inline delete confirmation -->
                    <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="12" Padding="16,12" Margin="0,14,0,0"
                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Delete" />
                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="? It is removed from the config repo too (and synced)." />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Keep it" Command="{Binding CancelDeleteCommand}" Margin="0,0,10,0"
                                        input:FocusCue.FocusWhenShown="True" />
                                <Button Content="Delete" AutomationProperties.Name="Confirm delete" Style="{StaticResource Button.Danger}" Command="{Binding ConfirmDeleteCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FilePreview" DataType="{x:Type vm:FilePreviewItem}">
            <Border Background="{StaticResource CardRaisedBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Id}" Style="{StaticResource Text.H3}" Margin="0,0,12,0" />
                        <Border Grid.Column="1" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Accent}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource TextFaintBrush}"
                               FontSize="12.5" Margin="0,4,0,0" Visibility="{Binding Path, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding SkipReason}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding IsSkipped, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0" Focusable="False"
                                  Visibility="{Binding HasChanges, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeyChangeItem}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Mono}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Current}" Style="{StaticResource Text.Mono}"
                                               Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="10,2" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="3" Text="{Binding Target}" Style="{StaticResource Text.Mono}"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,14">
        <!-- ============================================================ main -->
        <Grid x:Name="Main" IsEnabled="{Binding IsPreviewOpen, Converter={StaticResource Not}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- game header -->
            <Border Style="{StaticResource Card}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource Badge.Active}" Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding ActiveText}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding StoreText, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding StoreText}" />
                            </Border>
                            <Border Style="{StaticResource Badge}">
                                <TextBlock>
                                    <Run Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" />
                                    <Run Text="{Binding Device, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"
                                Visibility="{Binding CanLaunch, Converter={StaticResource VisibleWhen}}">
                        <Button AutomationProperties.Name="Launch game" Style="{StaticResource Button.Large}" Command="{Binding LaunchCommand}" ToolTip="{Binding LaunchHint}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Launch game" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding LaunchHint}" Style="{StaticResource Text.Caption}" FontWeight="Normal"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="260" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- config error -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <Border Style="{StaticResource Badge.Danger}" HorizontalAlignment="Left">
                        <TextBlock Text="Config error" />
                    </Border>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                               Text="Fix the game's yaml (gameprofiles validate shows details), then Refresh." />
                </StackPanel>
            </Border>

            <!-- tabs -->
            <Grid Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding HasGame, Converter={StaticResource VisibleWhen}}">
                <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTabIndex}">
                    <TabItem Header="Recommended">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="0,0,6,0">
                                <!-- intent + provenance -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16"
                                        Visibility="{Binding HasIntent, Converter={StaticResource VisibleWhen}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="YOUR INTENT ON" />
                                            <Run Text="{Binding Device, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding IntentText}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="4,0,0,14" Visibility="{Binding HasRecommendation, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal">
                                        <Run Text="&#xE946;" FontFamily="{StaticResource IconFont}" />
                                        <Run Text="Recommendations:" FontWeight="SemiBold" />
                                        <Run Text="{Binding RecommendationText, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="18,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" FontWeight="Normal"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource RecommendedCard}" Focusable="False"
                                              Visibility="{Binding HasRecommended, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- empty state -->
                                <Border Style="{StaticResource Card}" Padding="28,24" HorizontalAlignment="Left" MaxWidth="760"
                                        Visibility="{Binding HasRecommended, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                    <StackPanel>
                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Style="{StaticResource Text.H2}" Margin="0,10,0,0">
                                            <Run Text="No recommended presets for" />
                                            <Run Text="{Binding Device, Mode=OneWay}" />
                                            <Run Text="yet" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0">
                                            <Run Text="Ask Claude to run the game-settings skill —" />
                                            <Run Text="/game-settings-recommender" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentTextBrush}" />
                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource AccentTextBrush}" />
                                            <Run Text="— it researches the game's settings and writes presets for this device into" />
                                            <Run Text="config\games\" FontFamily="Cascadia Mono, Consolas" /><Run Text="{Binding GameId, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" /><Run Text=".yaml" FontFamily="Cascadia Mono, Consolas" /><Run Text=". Then Sync and Refresh. Meanwhile you can tune in-game and keep the result under Manual saves." />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Command="{Binding UseDefaultCommand}"
                                        Visibility="{Binding CanUseDefault, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock>
                                        <Run Text="&#xE777;" FontFamily="{StaticResource IconFont}" />
                                        <Run Text="Back to the device default" />
                                        <Run Text="{Binding DefaultPresetName, Mode=OneWay, StringFormat=({0})}" />
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <TextBlock>
                                <Run Text="Manual saves" />
                                <Run Text="{Binding Manual.Count, Mode=OneWay, StringFormat=({0})}" />
                            </TextBlock>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="0,0,6,0">
                                <!-- save current -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                                    <StackPanel>
                                        <Grid Visibility="{Binding IsSaveFormOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Tuned something in-game?" Style="{StaticResource Text.H3}" />
                                                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0">
                                                    <Run Text="Save the game's current settings as a named preset for" />
                                                    <Run Text="{Binding Device, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". It becomes the active preset and is synced through git." />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" AutomationProperties.Name="Save current settings" Style="{StaticResource Button.Large}" Command="{Binding OpenSaveFormCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Text="Save current settings…" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Visibility="{Binding IsSaveFormOpen, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="Save current settings" Style="{StaticResource Text.H3}" />
                                            <TextBlock Text="NAME" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
                                            <TextBox Text="{Binding NewSaveName, UpdateSourceTrigger=PropertyChanged}" FontSize="17" MinWidth="420"
                                                     HorizontalAlignment="Stretch" input:FocusCue.FocusWhenShown="True" />
                                            <TextBlock Text="NOTES (OPTIONAL)" Style="{StaticResource Text.Caption}" Margin="0,12,0,6" />
                                            <TextBox Text="{Binding NewSaveNotes, UpdateSourceTrigger=PropertyChanged}" MinWidth="420"
                                                     HorizontalAlignment="Stretch" />
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button AutomationProperties.Name="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCurrentCommand}" MinWidth="120">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="Save" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="Cancel" Command="{Binding CancelSaveFormCommand}" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="4,0,0,12"
                                           Visibility="{Binding HasLastSync, Converter={StaticResource VisibleWhen}}" />

                                <ItemsControl ItemsSource="{Binding Manual}" ItemTemplate="{StaticResource ManualCard}" Focusable="False" />

                                <Border Style="{StaticResource Card}" Padding="28,24" HorizontalAlignment="Left" MaxWidth="760"
                                        Visibility="{Binding HasManual, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.H3}">
                                            <Run Text="No manual saves for" />
                                            <Run Text="{Binding Device, Mode=OneWay}" />
                                            <Run Text="yet" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,8,0,0"
                                                   Text="Play with a recommended preset, adjust graphics in the game's own menu, quit, then save here. GameProfiles also offers to save when it notices in-game changes after a launch." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,16,4,0" Text="LB / RB or Ctrl+Tab to switch tabs" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- ============================================================ diff / confirm panel -->
        <Grid x:Name="Overlay" DataContext="{Binding Preview}" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              Visibility="{Binding DataContext.IsPreviewOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}">
            <Border Background="{StaticResource BackdropBrush}" CornerRadius="16" />
            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" MaxWidth="860" Margin="24" VerticalAlignment="Center" Padding="26,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="22" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Dim}" Margin="0,6,0,14" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding AlsoUse}" Content="Also use this preset for future launches"
                                  Visibility="{Binding ShowAlsoUse, Converter={StaticResource VisibleWhen}}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- apply mode -->
                            <Button AutomationProperties.Name="Confirm apply" Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" MinWidth="130" Margin="12,0,0,0"
                                    input:FocusCue.FocusWhenShown="True"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Apply now" />
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel" Command="{Binding CloseCommand}" Margin="10,0,0,0"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}}" />
                            <!-- preview mode -->
                            <Button Content="Apply now…" Command="{Binding SwitchToApplyCommand}" Margin="12,0,0,0"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <Button Content="Close" Command="{Binding CloseCommand}" Margin="10,0,0,0" MinWidth="110"
                                    input:FocusCue.FocusWhenShown="True"
                                    Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FilePreview}" Focusable="False" />
                            <Border Background="{StaticResource CardRaisedBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                                    Visibility="{Binding HasDriverLines, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Text="Driver" Style="{StaticResource Text.H3}" />
                                    <ItemsControl ItemsSource="{Binding DriverLines}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding DisplayNote}" Style="{StaticResource Text.Dim}" Margin="2,0,0,6"
                                       Visibility="{Binding HasDisplayNote, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
