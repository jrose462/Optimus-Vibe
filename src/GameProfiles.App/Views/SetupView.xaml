<UserControl x:Class="GameProfiles.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:GameProfiles.App.Input">
    <!-- DataContext: MainViewModel. Shown when no config folder resolves, or this machine matches no device. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" MaxWidth="680" Margin="32" Padding="36,32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Set up GameProfiles on this machine" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,12,0,0"
                           Text="GameProfiles reads its games, presets and manual saves from the config folder of your GameProfiles git repo (the folder that contains devices.yaml). Pick it once; it is remembered in %LOCALAPPDATA%\GameProfiles\settings.json." />

                <Border Style="{StaticResource Badge.Warn}" CornerRadius="12" Padding="14,10" Margin="0,18,0,0" HorizontalAlignment="Stretch"
                        Visibility="{Binding SetupMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding SetupMessage}" TextWrapping="Wrap" FontWeight="Normal" FontSize="14" />
                </Border>

                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,18,0,4" Text="CONFIG FOLDER" />
                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding ConfigRoot}" />

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Style="{StaticResource Button.Large}" Command="{Binding PickConfigFolderCommand}"
                            input:FocusCue.FocusWhenShown="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8DA;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Choose config folder…" />
                        </StackPanel>
                    </Button>
                    <Button Content="Retry" Command="{Binding RefreshCommand}" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Margin="0,28,0,0" Visibility="{Binding HasDeviceChoices, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Text.H3}" Text="Which device is this?" />
                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,6,0,12"
                               Text="This machine matched no device in devices.yaml. Pick one to always use here (same as `gameprofiles setup --force-profile`), or add a match rule to devices.yaml." />
                    <ItemsControl ItemsSource="{Binding DeviceChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,10,10" MinWidth="140"
                                        Command="{Binding DataContext.ForceDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
