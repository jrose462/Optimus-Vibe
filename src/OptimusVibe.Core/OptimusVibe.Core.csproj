<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OptimusVibe</RootNamespace>
    <AssemblyName>OptimusVibe.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OptimusVibe.Tests" />
    <InternalsVisibleTo Include="optimus-vibe" />
    <InternalsVisibleTo Include="OptimusVibe" />
  </ItemGroup>

  <!-- The generic starter config (seed\config) is embedded so the published exe can seed a new config repo or an empty
       folder without any repo checkout. Logical names look like "seed/config/games/_template.yaml". -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\seed\config\**\*" Exclude="..\..\seed\config\**\*.local-conflict"
                      LogicalName="seed/config/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The game-lab workflow + prompt files (seed\config-repo\**) are embedded so the guided setup can install them into the user's
       config repo. Logical names look like "seed/config-repo/.github/workflows/game-lab.yml". -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\seed\config-repo\**\*" Exclude="..\..\seed\config-repo\**\*.local-conflict"
                      LogicalName="seed/config-repo/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- GitHub OAuth App client id (public, not a secret): set OptimusVibeGitHubClientId in Directory.Build.props or with
       -p:OptimusVibeGitHubClientId=... ; readable at runtime through BuildInfo.GitHubClientId. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OptimusVibeGitHubClientId</_Parameter1>
      <_Parameter2>$(OptimusVibeGitHubClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Built-in bug-report token. Release builds get it from the BUG_REPORT_TOKEN environment variable (or
       -p:BugReportToken=...). It is XOR-ed with a random per-build key into a generated source file: that is
       obfuscation so the token isn't greppable in the exe, NOT security. The token must therefore be a
       least-privilege fine-grained token (Issues: read/write on the app repo only) owned by a bot account.
       Without a token (dev builds) the generated arrays are empty and the app falls back to a prefilled browser issue. -->
  <PropertyGroup>
    <BugReportToken Condition="'$(BugReportToken)' == ''">$(BUG_REPORT_TOKEN)</BugReportToken>
  </PropertyGroup>

  <UsingTask TaskName="GenerateBakedSecrets" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Token ParameterType="System.String" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] key = new byte[0];
        byte[] data = new byte[0];
        if (!string.IsNullOrWhiteSpace(Token))
        {
            var plain = Encoding.UTF8.GetBytes(Token.Trim());
            key = Guid.NewGuid().ToByteArray().Concat(Guid.NewGuid().ToByteArray()).ToArray();
            data = new byte[plain.Length];
            for (int i = 0; i < plain.Length; i++) data[i] = (byte)(plain[i] ^ key[i % key.Length]);
        }
        Func<byte[], string> arr = b => string.Join(",", b.Select(x => "0x" + x.ToString("x2")));
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated> Build-time obfuscated token (XOR with a random key). Not a security boundary. </auto-generated>");
        sb.AppendLine("namespace OptimusVibe.Feedback;");
        sb.AppendLine("internal static class BakedSecrets");
        sb.AppendLine("{");
        sb.AppendLine("    internal static readonly byte[] BugReportKey = new byte[] { " + arr(key) + " };");
        sb.AppendLine("    internal static readonly byte[] BugReportData = new byte[] { " + arr(data) + " };");
        sb.AppendLine("}");
        var text = sb.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            File.WriteAllText(OutputFile, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBakedSecretsFile" BeforeTargets="CoreCompile;BeforeCompile">
    <PropertyGroup>
      <BakedSecretsFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)BakedSecrets.g.cs'))</BakedSecretsFile>
    </PropertyGroup>
    <GenerateBakedSecrets Token="$(BugReportToken)" OutputFile="$(BakedSecretsFile)" />
    <ItemGroup>
      <Compile Include="$(BakedSecretsFile)" />
    </ItemGroup>
  </Target>

</Project>
